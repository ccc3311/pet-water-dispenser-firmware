# Preserve supplied C source bytes and raw uploads, including CRLF.
*.c -text
*.h -text
archive/** -text
*.md text eol=lf
*.json text eol=lf

# Preserve the complete desktop project byte for byte (mixed GBK/UTF-8).
TL2_T12/** -text
*.LIB binary
*.xlsx binary
*.db binary
*.png binary

# Preserve the original T13 Wi-Fi CEN snapshot, including project/output files.
TL2_T13/** -text

# Preserve the encodings and line endings of the reconstructed TL2 T14 project.
TL2_T14/** -text
