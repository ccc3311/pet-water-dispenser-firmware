              /**
               * @brief  UART0÷–∂œ≥ı ºªØ
               * @param  NewState[in]: ∂œ πƒ‹/πÿ±’—°‘Ò
               *              - DISABLE:πÿ±’
               *              - ENABLE: πƒ‹
               * @param  Priority[in]: ÷–∂œ”≈œ»º∂—°‘Ò
               *              - LOW:µÕ
               *              - HIGH:∏ﬂ
               * @retval None
               */ 
              void UART0_ITConfig(FunctionalState NewState,
                                  PriorityStatus Priority)
              {
                if(NewState == DISABLE)
                {
                  EUART0 = 0;
                }
                else
                {
                  EUART0 = 1;
                }
              
                //…Ë÷√÷–∂œ”≈œ»º∂
                if(Priority == LOW)
                {
                  IPUART0 = 0;
                }
                else
                {
                  IPUART0 = 1;
                }
              }
