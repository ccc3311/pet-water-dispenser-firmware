                              *(UART_HANDLE->pRxBuffPtr.Size_u8 + UART_HANDLE->RxXferCount) = U0SBUF;     //Ω” ’ ˝æ›
                          }
                          UART_HANDLE->RxXferCount++;
                          /* ≈–∂œ…œ“ª¥Œ∑¢ÀÕ «∑Ò «◊Ó∫Û“ª¥Œ */
                          if (UART_HANDLE->RxXferCount == UART_HANDLE->RxXferSize)
                          {
                              /* Ω” ’ÕÍ≥… */
                              UART_HANDLE->RxState = UART0_STATE_READY;
                              return Status_OK;
                          }
                          return Status_BUSY;
                      }
                      else
                      {
                          /* Ω” ’ ˝æ›¡øŒ™0 ±ªπΩ” ’ ˝æ›£¨∑µªÿ¥ÌŒÛ */
                          UART_HANDLE->RxState = UART0_STATE_ERROR;
C51 COMPILER V9.60.7.0   SC92F_UART0                                                       10/13/2026 10:46:34 PAGE 23  

                          return Status_ERROR;
                      }
                  }
                  else
                  {
                      return Status_BUSY;
                  }
              }
