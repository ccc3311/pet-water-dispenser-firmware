 117          /**
 118            * @brief  Calculate the CRC check value of the input frame.
 119            * @param  buff:Input the array that needs to be computed for CRC.
 120            * @param  Length:Length of the array to be calculated.
 121            * @retval CRC_Result:32-bit CRC.
 122            */
 123          uint32_t CRC_Frame(uint8_t *buff, uint8_t Length)
 124          {
 125   1        uint8_t i;
 126   1        uint32_t CRC_Result = 0;
 127   1        
 128   1        EA = 0;
 129   1        OPERCON |= 0x02;
 130   1        _nop_();
 131   1        _nop_();
 132   1        _nop_();
 133   1        _nop_();
 134   1        _nop_();
 135   1        _nop_();
 136   1        _nop_();
 137   1        _nop_();
 138   1        _nop_();
 139   1        _nop_();
 140   1      
 141   1        for (i = 0; i < Length; i++)
 142   1        {
 143   2          CRC_Result = *(buff + i);
 144   2          CRCREG = CRC_Result;
 145   2          _nop_();
 146   2          _nop_();
 147   2          _nop_();
 148   2          _nop_();
 149   2          _nop_();
 150   2          _nop_();
 151   2          _nop_();
 152   2          _nop_();
 153   2          _nop_();
 154   2          _nop_();
 155   2        }
 156   1      
 157   1        CRCINX = 0x00;
 158   1        CRC_Result = CRCREG;
 159   1        CRC_Result = CRCREG * 256 + CRC_Result;
 160   1        CRC_Result = CRCREG * 65536 + CRC_Result;
 161   1        CRC_Result = CRCREG * 16777216 + CRC_Result;
 162   1        EA = 1;
 163   1      
 164   1        return CRC_Result;
 165   1      }
