 110          /* 打印模式配置UART0；UV模式不启用该串口。 */
 111          void SC_UART0_Init(void)
 112          {
 113   1      #if APP_CHARGE_DEBUG
 114   1          /* putchar轮询TI，关闭UART0中断，避免中断清除发送完成标志。 */
 115   1          UART0_ITConfig(DISABLE, LOW);
C51 COMPILER V9.60.7.0   SC_INIT                                                           10/22/2026 15:13:08 PAGE 3   

 116   1      
 117   1          /* 保持32MHz、9600波特率，使用Timer1作为波特率发生器。 */
 118   1          UART0_Init(
 119   1              32000000,
 120   1              9600,
 121   1              UART0_Mode_10B,
 122   1              UART0_CLOCK_TIMER1,
 123   1              UART0_RX_ENABLE);
 124   1      #endif
 125   1      }
