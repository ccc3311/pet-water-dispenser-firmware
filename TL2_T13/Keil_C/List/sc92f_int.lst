 279          /**
 280           * @brief INT0 interrupts initialization
 281           * @param  NewState[in]: Disable Enable/Disable selection
 282           *              - DISABLE:Off
 283           *              - ENABLE:enable
 284           * @param  Priority[in]: Interrupt priority selection
 285           *              - LOW:low
 286           *              - HIGH:high
 287           * @retval None
 288           */ 
 289          void INT0_ITConfig(FunctionalState NewState,
 290                             PriorityStatus Priority)
C51 COMPILER V9.60.7.0   SC92F_INT                                                         10/13/2026 10:46:29 PAGE 6   

 291          {
 292   1        if(NewState != DISABLE)
 293   1        {
 294   2          IE |= 0X01;
 295   2        }
 296   1        else
 297   1        {
 298   2          IE &= (~0X01);
 299   2        }
 300   1      
 301   1        if(Priority == LOW)
 302   1        {
 303   2          IP &= ~0X01;
 304   2        }
 305   1        else
 306   1        {
 307   2          IP |= 0X01;
 308   2        }
 309   1      }
