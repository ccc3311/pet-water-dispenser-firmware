 154          /**
 155           * @brief  INT0x Interrupt trigger configuration function
 156           * @param  INT0x[in]: INT0x Select
 157           * @param  TriggerMode[in]: 
 158           *              - INT_TRIGGER_RISE_ONLY:The external interrupt triggering mode is ascending edge
 159           *              - INT_TRIGGER_FALL_ONLY:The external interrupt triggering mode is falling edge
 160           *              - INT_TRIGGER_RISE_FALL:The external interrupt triggering modes are rising edge and fallin
             -g edge
 161           *              - INT_TRIGGER_DISABLE:Disable external interrupt triggering
 162           * @retval None
 163           */ 
 164          void INT0_SetTriggerMode(uint8_t INT0x,
 165                                   INT_TriggerMode_Typedef TriggerMode)
 166          {
 167   1        switch(TriggerMode)
 168   1        {
 169   2          case INT_TRIGGER_RISE_ONLY:
 170   2            INT0R |= INT0x;
 171   2            INT0F &= (~INT0x);
C51 COMPILER V9.60.7.0   SC92F_INT                                                         10/13/2026 10:46:29 PAGE 4   

 172   2            break;
 173   2      
 174   2          case INT_TRIGGER_FALL_ONLY:
 175   2            INT0R &= (~INT0x);
 176   2            INT0F |= INT0x;
 177   2            break;
 178   2      
 179   2          case INT_TRIGGER_RISE_FALL:
 180   2            INT0R |= INT0x;
 181   2            INT0F |= INT0x;
 182   2            break;
 183   2      
 184   2          case INT_TRIGGER_DISABLE:
 185   2            INT0R &= (~INT0x);
 186   2            INT0F &= (~INT0x);
 187   2      
 188   2          default:
 189   2            break;
 190   2        }
 191   1      }
