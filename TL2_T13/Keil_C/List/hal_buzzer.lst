   4          #define BUZZER_PIN P26
   5          
   6          // --- 蜂鸣器状态机内部变量 ---
   7          typedef enum {
   8              BZ_IDLE = 0,    // 空闲状态
   9              BZ_ON,          // 正在发声状态
  10              BZ_OFF_GAP      // 多次鸣叫之间的静音间隔
  11          } BuzzerState_t;
  12          
  13          static volatile  BuzzerState_t bz_state = BZ_IDLE; // 当前状态
  14          static uint8_t  bz_remains = 0;          // 还需要鸣叫的次数
  15          static uint16_t bz_timer_ms = 0;         // 内部非阻塞倒计时器
  16          
  17          /**
  18           * @brief  蜂鸣器初始化
  19           */
  20          void HAL_Buzzer_Init(void) {
  21   1          BUZZER_PIN = 0;     // 初始静音
  22   1      }
  23          
  24          /**
  25           * @brief  发起蜂鸣器鸣叫任务 (非阻塞！瞬间返回！)
  26           * @param  times: 鸣叫次数
  27           */
  28          void HAL_Buzzer_Beep(uint8_t times) {
  29   1          if (times == 0) return;
  30   1      if (g_Device.mute_enabled) return; // 【核心】：如果开启了静音，直接憋回去不响    
  31   1          // 注入任务参数
  32   1          bz_remains = times;
  33   1          bz_state = BZ_ON;
  34   1          bz_timer_ms = 100; // 设定单次发声时间为 100ms
  35   1          
  36   1          BUZZER_PIN = 1;    // 立刻开始发声
  37   1      }
  38          
  39          /**
  40           * @brief  蜂鸣器状态机驱动引擎 (必须在 main.c 中每 1ms 调用一次)
  41           * @note   绝无死延时，通过每次减 1 实现时间流逝
  42           */
  43          void HAL_Buzzer_Tick_1ms(void) {
  44   1          // 如果处于空闲状态，直接退出，不占用 CPU 算力
  45   1          if (bz_state == BZ_IDLE) return;
  46   1          
  47   1          // 倒计时递减
  48   1          if (bz_timer_ms > 0) {
  49   2              bz_timer_ms--;
  50   2          }
  51   1          
  52   1          // 时间到了，进行状态转移
  53   1          if (bz_timer_ms == 0) {
C51 COMPILER V9.60.7.0   HAL_BUZZER                                                        10/20/2026 16:39:30 PAGE 2   

  54   2              if (bz_state == BZ_ON) {
  55   3                  // 发声时间结束，关闭蜂鸣器
  56   3                  BUZZER_PIN = 0;
  57   3                  bz_remains--; // 完成了一次鸣叫
  58   3                  
  59   3                  if (bz_remains > 0) {
  60   4                      // 如果还需要叫，进入静音间隔态
  61   4                      bz_state = BZ_OFF_GAP;
  62   4                      bz_timer_ms = 100; // 停顿 100ms 再叫下一声
  63   4                  } else {
  64   4                      // 任务彻底完成
  65   4                      bz_state = BZ_IDLE;
  66   4                  }
  67   3              } 
  68   2              else if (bz_state == BZ_OFF_GAP) {
  69   3                  // 间隔停顿时间结束，进入下一次发声
  70   3                  bz_state = BZ_ON;
  71   3                  bz_timer_ms = 100; // 发声 100ms
  72   3                  BUZZER_PIN = 1;
  73   3              }
  74   2          }
  75   1      }
  76          
  77          /**
  78           * @brief  发起蜂鸣器 3 秒长鸣任务 (非阻塞！瞬间返回！)
  79           * @note   利用现有的 tick 引擎，直接注入 3000ms 的发声时间
  80          //修改：实际体感3s太长，修改为800ms
  81           */
  82          void HAL_Buzzer_Beep_3s(void) {
  83   1        // 【核心修复】：长鸣也必须受静音开关控制，防止越权发声
  84   1          if (g_Device.mute_enabled) return;
  85   1          // 强制覆盖当前可能正在进行的蜂鸣器任务
  86   1          bz_remains = 1;        // 只需要叫这一次
  87   1          bz_state = BZ_ON;      // 切入发声状态
  88   1          bz_timer_ms = 800;    // 设定单次发声时间为 3000ms (3秒)
  89   1          
  90   1          BUZZER_PIN = 1;        // 立刻开始发声
  91   1      }
  92          
  93          uint8_t HAL_Buzzer_IsBusy(void)
  94          {
  95   1          return (bz_state != BZ_IDLE);
  96   1      }


