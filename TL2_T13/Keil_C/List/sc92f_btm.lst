 100          /**
 101           * @brief  Enables or disables the specified BTM peripheral.
 102           * @param  NewState[in]: new state of the BTMx peripheral.
 103           *                  - DISABLE:Function disable
 104           *                  - ENABLE:Function enable 
 105           * @retval None
 106           */
 107          void BTM_Cmd(FunctionalState NewState)
 108          {
 109   1        if(NewState == DISABLE)
 110   1        {
 111   2          BTMCON &= 0x7f;     //Disable BTM
 112   2        }
 113   1        else
 114   1        {
 115   2          BTMCON |= 0x80;     //Enable BTM
