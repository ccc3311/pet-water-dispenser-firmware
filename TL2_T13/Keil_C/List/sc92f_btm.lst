 136          /**
 137           * @brief  Enables or disables the specified BTM interrupts.
 138           * @param  NewState[in]: new state of the BTM interrupts.
 139           *                  - DISABLE:Function disable
 140           *                  - ENABLE:Function enable 
 141           * @param  Priority[in]: priority of the BTM interrupts.
 142           *                  - LOW:Low priority
 143           *                  - HIGH:High priority
 144           * @retval None
 145           */
 146          void BTM_ITConfig(FunctionalState NewState,
 147                            PriorityStatus Priority)
 148          {
 149   1        //interrupt configuration
 150   1        if(NewState == DISABLE)
 151   1        {
 152   2          IE1 &= 0xfb;
 153   2        }
 154   1        else
 155   1        {
 156   2          IE1 |= 0x04;
 157   2        }
 158   1      
 159   1        //Interrupt Priority Setting
 160   1        if(Priority == LOW)
 161   1        {
 162   2          IP1 &= 0xfb;
 163   2        }
 164   1        else
 165   1        {
 166   2          IP1 |= 0x04;
 167   2        }
 168   1      }
 169          /**
 170           * @}
 171           */
 172          /* End of BTM_Group2. */
