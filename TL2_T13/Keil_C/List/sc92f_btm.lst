  58          /**
  59           * @brief  Initialize the BTMx peripheral registers.
  60           * @param  BTM_Timebase[in]: BTM overflow time selection
  61           *              SC92F748x,SC92F848x,SC92F859x,SC92F759x,SC92L853x,SC92R511x,SC92F6x1x,SC92F5x1x,
  62           *              SC92R436,SC92R439,SC92R422A,SC92F652x,SC92F637x
  63           *                   Selection range(BTM_TIMEBASE_15_625MS - BTM_TIMEBASE_32S)
  64           *              SC92F84Hx,SC92F83Hx
  65           *                   Selection range(BTM_TIMEBASE_15_625MS - BTM_TIMEBASE_256S)
  66           *              SC92F732X
  67           *                   Selection range(BTM_TIMEBASE_15_625MS - BTM_TIMEBASE_2S)
  68           *              SC92F663x
  69           *                   Selection range(0 - 65535, Converted to time, it is 3.125 ms - 204.8 s)
  70           *              else
  71           *                   Selection range(BTM_TIMEBASE_15_625MS - BTM_TIMEBASE_4S)
  72           *                   - BTM_TIMEBASE_15_625MS:Every 15.625 milliseconds generates one interrupt.
  73           *                   - BTM_TIMEBASE_31_25MS:Every 31.25 milliseconds generates one interrupt.
  74           *                   - BTM_TIMEBASE_62_5MS:Every 62.5 milliseconds generates one interrupt.
  75           *                   - BTM_TIMEBASE_125MS:Every 125 milliseconds generates one interrupt.
  76           *                   - BTM_TIMEBASE_250MS:Every 250 milliseconds generates one interrupt.
  77           *                   - BTM_TIMEBASE_500MS:Every 500 milliseconds generates one interrupt.
  78           *                   - BTM_TIMEBASE_1S:Every 1 seconds generates one interrupt.
  79           *                   - BTM_TIMEBASE_2S:Every 2 seconds generates one interrupt.
  80           *                   - BTM_TIMEBASE_8S:Every 8 seconds generates one interrupt.
  81           *                   - BTM_TIMEBASE_16S:Every 16 seconds generates one interrupt.
  82           *                   - BTM_TIMEBASE_32S:Every 32 seconds generates one interrupt.
  83           *                   - BTM_TIMEBASE_64S:Every 64 seconds generates one interrupt.
  84           *                   - BTM_TIMEBASE_128S:Every 128 seconds generates one interrupt.
  85           *                   - BTM_TIMEBASE_256S:Every 256 seconds generates one interrupt.
  86           * @retval None
  87           */
  88          #if defined(SC92F663x)
              void BTM_Init(uint16_t BTM_Timebase)
              {
                BTMCNT = BTM_Timebase;      //configure overflow time
              }
              #else
  94          void BTM_Init(BTM_Timebase_TypeDef BTM_Timebase)
  95          {
  96   1        BTMCON = (BTMCON & 0xF0) | BTM_Timebase;      //configure overflow time
  97   1      }
  98          #endif
