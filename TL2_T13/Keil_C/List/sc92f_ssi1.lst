              void SSI1_ClearFlag(SSI_Flag_TypeDef SSI_FLAG)
              {
                if((SSI_FLAG == SPI_FLAG_SPIF) ||
                    (SSI_FLAG == SPI_FLAG_WCOL) ||
                    (SSI_FLAG == SPI_FLAG_TXE))
                {
                  SS1CON1 &= (~SSI_FLAG);
