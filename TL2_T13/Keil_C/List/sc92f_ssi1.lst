              void SSI1_ITConfig(FunctionalState NewState,
                                 PriorityStatus Priority)
              {
                //÷–∂œ πƒ‹/πÿ±’…Ë÷√
                if(NewState != DISABLE)
                {
                  IE1 |= 0x01;
                }
                else
                {
                  IE1 &= 0xFE;
                }
              
                //÷–∂œ”≈œ»º∂…Ë÷√
                if(Priority != LOW)
                {
                  IP1 |= 0x01;
                }
                else
                {
                  IP1 &= 0xFE;
                }
              }
              
              
