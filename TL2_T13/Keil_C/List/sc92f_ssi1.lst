              FlagStatus SSI1_GetFlagStatus(SSI_Flag_TypeDef
                                            SSI_FLAG)
              {
                FlagStatus bitstatus = RESET;
              
                if((SSI_FLAG == SPI_FLAG_SPIF) ||
                    (SSI_FLAG == SPI_FLAG_WCOL) ||
                    (SSI_FLAG == SPI_FLAG_TXE))
                {
