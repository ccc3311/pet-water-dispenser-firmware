  90          void HAL_Power_Init(void)
  91          {
  92   1          bit saved_ea;
  93   1      
  94   1          /*
  95   1           * 配置多个相关寄存器时，暂时关闭中断。
  96   1           * 完成后恢复调用前的EA状态。
  97   1           */
  98   1          saved_ea = EA;
  99   1          EA = 0;
 100   1      
 101   1          s_btm_ticks = 0;
 102   1          s_input_event = 0;
 103   1      
 104   1          /*
 105   1           * 配置INT2三路输入的边沿。
 106   1           *
 107   1           * 先清除这三路的旧配置，再设置新配置。
 108   1           * 保留INT20、INT21、INT24的原有配置。
 109   1           *
 110   1           * INT2R：上升沿使能寄存器
 111   1           * INT2F：下降沿使能寄存器
 112   1           */
 113   1          INT2R =
 114   1              (INT2R & (uint8_t)(~POWER_INT2_INPUT_MASK)) |
 115   1              POWER_INT2_RISE_MASK;
C51 COMPILER V9.60.7.0   HAL_POWER                                                         10/13/2026 10:46:41 PAGE 3   

 116   1      
 117   1          INT2F =
 118   1              (INT2F & (uint8_t)(~POWER_INT2_INPUT_MASK)) |
 119   1              POWER_INT2_FALL_MASK;
 120   1      
 121   1          /*
 122   1           * BTM配置顺序：
 123   1           *
 124   1           * 1. 关闭BTM中断；
 125   1           * 2. 停止BTM并设置125ms周期；
 126   1           * 3. 开启BTM和INT2中断；
 127   1           * 4. 启动BTM。
 128   1           */
 129   1      
 130   1          IE1 &= (uint8_t)(~POWER_IE1_EBTM);
 131   1      
 132   1          /*
 133   1           * ENBTM=0：停止
 134   1           * BTMIF=0：清除旧标志
 135   1           * BTMFS=0011：125ms
 136   1           */
 137   1          BTMCON = POWER_BTM_PERIOD_125MS;
 138   1      
 139   1          IE1 |= POWER_IE1_EBTM | POWER_IE1_EINT2;
 140   1      
 141   1          BTMCON |= POWER_BTM_ENABLE;
 142   1      
 143   1          /*
 144   1           * 不在每次STOP前重启BTM。
 145   1           *
 146   1           * BTM持续运行，才能让低频节拍包含
 147   1           * MCU短暂醒着巡检的时间。
 148   1           */
 149   1          EA = saved_ea;
 150   1      }
