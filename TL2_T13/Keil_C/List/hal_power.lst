  15           */
  16          #define POWER_TIM0_RELOAD       33536U
  17          
  18          /*
  19           * IE1中断使能位：
  20           * bit2：EBTM
  21           * bit3：EINT2
  22           */
  23          #define POWER_IE1_EBTM          0x04
  24          #define POWER_IE1_EINT2         0x08
  25          
  26          /*
  27           * BTMCON：
  28           * bit7：ENBTM，启动BTM
  29           * bit6：BTMIF，中断标志
  30           * bit3~0：周期选择
