  34          #define POWER_BTM_PERIOD_125MS  0x03
  35          
  36          ///*
  37          // * INT2输入选择：
  38          // *
  39          // * bit2：INT22，对应P06
  40          // * bit3：INT23，对应P07
  41          // * bit5：INT25，对应P21
  42          // */
  43          //#define POWER_INT2_INPUT_MASK   0x2C
  44          ///* P06、P21：高有效，使用上升沿 */
  45          //#define POWER_INT2_RISE_MASK    0x24
  46          ///* P07：低有效，使用下降沿 */
  47          //#define POWER_INT2_FALL_MASK    0x08
  48          
  49          /*
  50           * 本模块管理 INT22～INT25：
  51           * P0.6：红外输入，上升沿
  52           * P0.7：主触摸输入，下降沿
  53           * P2.0：Wi-Fi唤醒输入，上升沿
C51 COMPILER V9.60.7.0   HAL_POWER                                                         10/13/2026 10:46:41 PAGE 2   

  54           * P2.1：Wi-Fi控制输出，关闭其外部中断边沿
