 244          
 245          void HAL_Power_Prepare(void)
 246          {
 247   1          bit saved_ea;
 248   1      
 249   1          saved_ea = EA;
 250   1          EA = 0;
 251   1      
 252   1          /*
 253   1           * 保存状态。
 254   1           * 因此Prepare不能在尚未Resume时再次调用，
 255   1           * 否则会用“已停止”的状态覆盖原来的状态。
 256   1           */
