  56          #define POWER_INT2_INPUT_MASK   0x3Cu
  57          #define POWER_INT2_RISE_MASK    0x14u
  58          #define POWER_INT2_FALL_MASK    0x08u
  59          
  60          /*
  61           * 中断负责增加，主循环负责读取并清空。
  62           * 8051是8位CPU，读取16位变量不是一次完成，
  63           * 因此主循环消费它时需要短暂关闭总中断。
  64           */
  65          static volatile uint16_t s_btm_ticks = 0;
  66          
  67          
  68          /*
  69           * 外部输入事件锁存。
