                    break;
              
                  case PWM2PWM5:
                    PWMDTYA = PWMDTYA & 0xcf | ((tmpRegValue % 4) << 4);
                    PWMDTY2 = (uint8_t)(tmpRegValue >> 2);
                    break;
              
                  default:
                    break;
                }
                return SUCCESS;
              }
              
