               * @retval None
               */ 
              void PWM_OutputStateConfig(uint8_t PWM_OutputPin,
                                         PWM_OutputState_TypeDef PWM_OutputState)
              {
                if(PWM_OutputState == ENABLE)
                {
                  PWMREG[PWM_OutputPin] |= 0x80;
                }
                else
                {
                  PWMREG[PWM_OutputPin] &= 0x7F;
                }
              }
              
