4734           *          - ERROR:失败
4735           *          - SUCCESS:成功
4736           */ 
4737          ErrorStatus PWM_ComplementaryMode_DutyChange(PWM_ComplementaryOutputPin_TypeDef PWM_ComplementaryOutputPin
             -,
4738              PWM_DutyChange_TypeDef Change_Direction, uint16_t DutyIncremental)
4739          {
4740   1        uint8_t tmpRegValue;
4741   1        uint16_t tmpPolarity = PWMPDL + (PWMPDH << 8);
4742   1      
4743   1        tmpRegValue = PWMREG[PWM_ComplementaryOutputPin * 2];     //把当前占空比寄存器放进临时变量
4744   1        if(Change_Direction == PWM_DutyChange_Up)
4745   1        {
4746   2          tmpRegValue += DutyIncremental;       //占空比增加
4747   2        }
4748   1        else
4749   1        {
4750   2          tmpRegValue -= DutyIncremental;       //占空比减少
4751   2        }
4752   1      
4753   1        /* 计数器发生了向上溢出 */
4754   1        if(tmpRegValue > tmpPolarity)
4755   1          return ERROR;
4756   1        PWMREG[PWM_ComplementaryOutputPin] = tmpRegValue;   //占空比寄存器赋值
4757   1        return SUCCESS;
4758   1      }
