4680           *          - PWM53:PWM输出通道选择:PWM53
4681           * @param  Change_Direction[in]:PWM修改方向
4682           *          - PWM_DutyChange_Up:PWM占空比增加
4683           *          - PWM_DutyChange_Dowm:PWM占空比减少
4684           * @retval 返回修改成功状态位
4685           *          - ERROR:失败
4686           *          - SUCCESS:成功
4687           */
4688          ErrorStatus PWM_IndependentMode_DutyChange(PWM_OutputPin_TypeDef PWM_OutputPin,
4689              PWM_DutyChange_TypeDef Change_Direction, uint16_t DutyIncremental)
4690          {
4691   1        uint8_t i;
4692   1        uint8_t tmpRegValue;
4693   1      
4694   1        for(i = 0; i < 8; i++)
4695   1        {
4696   2          if(PWM_OutputPin & (0x01 << i))
4697   2          {
4698   3            tmpRegValue = PWMREG[i];      //把当前占空比寄存器放进临时变量
4699   3            if(Change_Direction == PWM_DutyChange_Up)
4700   3            {
4701   4              tmpRegValue += DutyIncremental;       //占空比增加
4702   4      
4703   4              /* 计数器发生了向上溢出 */
4704   4              if(tmpRegValue < PWMREG[i])
4705   4                return ERROR;
4706   4            }
4707   3            else
4708   3            {
4709   4              tmpRegValue -= DutyIncremental;       //占空比减少
4710   4      
4711   4              /* 计数器发生了向下溢出 */
4712   4              if(tmpRegValue < PWMREG[i])
4713   4                return ERROR;
4714   4            }
4715   3            PWMREG[i] = tmpRegValue;    //占空比寄存器赋值
C51 COMPILER V9.60.7.0   SC92F_PWM                                                         10/13/2026 10:46:32 PAGE 78  

4716   3          }
4717   2        }
4718   1        return SUCCESS;
4719   1      }
