 248          /**
 249           * @brief  32MHz 1T 单片机专属的微秒延时 (基于 Keil O8 优化等级)
 250           * @param  us: 需要延时的微秒数
 251           */
 252          static void Delay_us(uint16_t us) {
 253   1          uint8_t i;
 254   1          while (us--) {
 255   2              // while(us--) 判断本身约消耗 8~10 个时钟周期
 256   2              // 还需要补充 22 个系统时钟 (32MHz 下 1us = 32 个时钟)
 257   2              i = 7; 
 258   2              while (--i); // 每次 --i 约消耗 3 个时钟，7 * 3 = 21 个时钟
 259   2          }
 260   1      }
