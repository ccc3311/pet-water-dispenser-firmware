 106          /**
 107           * @brief  [51优化版] 通过实时 BAT 电压和 ADC 值计算 100K NTC 温度
 108           * @param  adc_val: ADC 原始读数 (0-4095)
 109           * @retval 温度值 (℃)
 110           */
 111          static int8_t Convert_NTC_ADC_To_Temp(uint16_t adc_val) {
 112   1          uint32_t v_adc_mv;
 113   1          uint32_t v_bat_mv;
 114   1          uint32_t r_ntc;
 115   1          uint8_t i;
C51 COMPILER V9.60.7.0   HAL_ADC                                                           10/20/2026 16:39:30 PAGE 3   

 116   1          int8_t temp_calc;
 117   1          uint32_t numerator;
 118   1          uint32_t denominator;
 119   1          // 1. 获取实时 BAT 电压 (全局变量，单位 mV)
 120   1          v_bat_mv = 3300;//现在方案温度改为固定3.3V
 121   1          // 2. 计算 ADC 引脚上的实际电压 (mV)
 122   1          // 公式: V_adc = ADC_val * VREF / 4095
 123   1          // 注意：adc_val * 2400 最大约 982 万，uint32_t 完全够用
 124   1          v_adc_mv = ((uint32_t)adc_val * VREF_MV) / ADC_RESOLUTION;
 125   1      
 126   1          // 3. 硬件容错 1：ADC 读数饱和 (>= 4090)
 127   1          // 说明 NTC 阻值极大 (断路或极冷)，或者输入电压超过了 VREF(2400mV)
 128   1          if (adc_val >= 4090) {
 129   2              return 100; // 故意返回假高温，触发 FSM 停止加热防灾 (保持你原代码逻辑)
 130   2          }
 131   1          
 132   1          // 4. 硬件容错 2：防止分母为 0 或负数
 133   1          // 如果 V_adc >= V_bat，说明物理电路异常或 ADC 读数错乱
 134   1          if (v_adc_mv >= v_bat_mv) {
 135   2              return 100; // 异常高温保护
 136   2          }
 137   1      
 138   1          // 5. 计算 NTC 实时阻值 (核心公式)
 139   1          // 公式: R_ntc = (R_pullup * V_adc) / (V_bat - V_adc)
 140   1          // 分子最大: 510,000 * 2400 = 1,224,000,000 (12.24亿)
 141   1          // uint32_t 最大值: 4,294,967,295 (42.9亿) -> 绝对不会溢出！
 142   1           numerator = NTC_PULLUP_RESISTOR_OHM * v_adc_mv;
 143   1           denominator = v_bat_mv - v_adc_mv;
 144   1          
 145   1          r_ntc = numerator / denominator;
 146   1      
 147   1          // 6. 查阻值表 -> 温度 (线性插值)
 148   1          // 表中阻值是降序排列的 (326K -> 5.6K)
 149   1          
 150   1          // 边界检查：阻值过大 (太冷，超出表格下限)
 151   1          if (r_ntc >= NTC_RES_LUT[0].resistance) {
 152   2              return NTC_RES_LUT[0].temp; // 返回 0℃
 153   2          }
 154   1          
 155   1          // 边界检查：阻值过小 (太热，超出表格上限)
 156   1          if (r_ntc <= NTC_RES_LUT[NTC_RES_TABLE_SIZE - 1].resistance) {
 157   2              return NTC_RES_LUT[NTC_RES_TABLE_SIZE - 1].temp; // 返回 100℃
 158   2          }
 159   1      
 160   1          // 遍历寻找区间
 161   1          for (i = 0; i < NTC_RES_TABLE_SIZE - 1; i++) {
 162   2              if (r_ntc <= NTC_RES_LUT[i].resistance && r_ntc > NTC_RES_LUT[i+1].resistance) {
 163   3                  
 164   3                  uint32_t r_diff = NTC_RES_LUT[i].resistance - NTC_RES_LUT[i+1].resistance;
 165   3                  uint32_t r_offset = NTC_RES_LUT[i].resistance - r_ntc;
 166   3                  int8_t temp_step = NTC_RES_LUT[i+1].temp - NTC_RES_LUT[i].temp; // 通常是 10 或 5
 167   3                  
 168   3                  // 线性插值公式: 当前温度 = 起点温度 + (偏移比例 * 温度步长)
 169   3                  // r_offset * temp_step 最大约 12万 * 10 = 120万，uint32_t 无压力
 170   3                  temp_calc = NTC_RES_LUT[i].temp + ((r_offset * temp_step) / r_diff);
 171   3                  return temp_calc;
 172   3              }
 173   2          }
 174   1      
 175   1          return 25; // 兜底容错返回
 176   1      }
