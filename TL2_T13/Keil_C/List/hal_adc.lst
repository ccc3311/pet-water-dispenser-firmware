 556          
 557          /*
 558           * 仅低功耗状态调用。
 559           * 不改变正常采样缓存。
 560           * 函数结束时关闭ADC，成功/失败路径均关闭。
 561           */
 562          /* 休眠巡检只测电池，退出时关闭 ADC。 */
 563          uint8_t HAL_ADC_PowerPoll(uint16_t *battery_mv)
 564          {
 565   1          uint16_t battery_raw;
 566   1          uint32_t mv;
 567   1      
 568   1          if (!ADC_PowerReadAverage(BAT_ADC_CHANNEL, &battery_raw)) {
 569   2              ADCCON &= 0x7F;
 570   2              return 0;
 571   2          }
 572   1      
 573   1          ADCCON &= 0x7F;
 574   1      
 575   1          mv = ((uint32_t)battery_raw * VREF_MV) / ADC_RESOLUTION;
 576   1          *battery_mv = (uint16_t)(mv * VOLTAGE_DIV_RATIO);
 577   1      
 578   1          return 1;
 579   1      }
