 377          /**
 378           * @brief  集中采集所有传感器数据 (每 500ms 调用一次)
 379           */
 380          void HAL_ADC_Sample_All(void) {
 381   1          uint16_t adc_val;
 382   1          uint32_t temp_mv;
 383   1          uint8_t i, j;
 384   1          uint16_t temp_swap;
 385   1          uint32_t tds_sum = 0;
 386   1                uint16_t adc_fwd; // 读取正向ADC
 387   1                uint16_t adc_rev; // 读取反向ADC
 388   1        
 389   1          s_adc_read_failed = 0;
 390   1          // ---------------------------------------------------------
 391   1          // 任务 1：系统电压采集 (Pin 22 / AIN0) - 带 3 次平均滤波
 392   1          // ---------------------------------------------------------
 393   1          adc_val  = ADC_Read_Channel(BAT_ADC_CHANNEL);
 394   1          adc_val += ADC_Read_Channel(BAT_ADC_CHANNEL);
 395   1          adc_val += ADC_Read_Channel(BAT_ADC_CHANNEL);
 396   1          adc_val /= 3;
 397   1      
 398   1          // 电压换算公式：mV = (adc_val * VREF_MV / 4095) * 分压比
 399   1          temp_mv = ((uint32_t)adc_val * VREF_MV) / ADC_RESOLUTION;
 400   1          cached_sys_voltage_mv = (uint16_t)(temp_mv * VOLTAGE_DIV_RATIO);
 401   1          // ========================================================
 402   1          // [新增] 刷新电池电量百分比
 403   1          // ========================================================
 404   1          {
 405   2              uint8_t is_ac = (g_Device.power_mode == POWER_AC);
 406   2              // 判断当前水泵是否正在耗电（如果你还有 UVC 也可以算进去，看功率占比）
 407   2              uint8_t pump_is_on = (g_Device.state == STATE_SENSING || g_Device.state == STATE_CONTINUOUS);
 408   2              
 409   2              // 调用算法更新缓存
 410   2              cached_bat_soc = Calculate_Battery_Tier(cached_sys_voltage_mv, is_ac, pump_is_on);
 411   2          }
 412   1      
 413   1          // ---------------------------------------------------------
 414   1          // 任务 2：NTC 温度采集 (Pin 27 / AIN5)
 415   1          // ---------------------------------------------------------
 416   1          adc_val  = ADC_Read_Channel(5);
 417   1          adc_val += ADC_Read_Channel(5);
 418   1          adc_val += ADC_Read_Channel(5);
 419   1          adc_val /= 3;
 420   1      //                    printf("adcadc  : %u \r\n", ADC_Read_Channel(3));
 421   1      
 422   1          // 调用查表算法，刷新温度缓存
 423   1          cached_temperature_c = Convert_NTC_ADC_To_Temp(adc_val);
 424   1      // ！！！屏蔽内鬼：在调校 TDS 期间，强制锁定 25℃ ！！！
 425   1          cached_temperature_c = 25;        
C51 COMPILER V9.60.7.0   HAL_ADC                                                           10/20/2026 16:39:30 PAGE 8   

 426   1          // ---------------------------------------------------------
 427   1          // 任务 3：TDS & 缺水复用检测 - 完美防极化 + 中值滤波
 428   1          // ---------------------------------------------------------
 429   1      
 430   1          // a. 确保 TDSAC 引脚为推挽输出 (通常在初始化里做过了，这里加个保险)
 431   1          // 移除了抢占 PWMCON 的代码，因为 P0.2/P0.3 在新板子上本来就不做硬件 PWM
 432   1          GPIO_Init(GPIO2, GPIO_PIN_4, GPIO_MODE_OUT_PP); 
 433   1          GPIO_Init(GPIO2, GPIO_PIN_5, GPIO_MODE_OUT_PP);
 434   1      
 435   1          // ========================================================
 436   1          // [新增] 连续进行 10 次独立的防极化采样
 437   1          // ========================================================
 438   1            for (i = 0; i < TDS_SAMPLE_NUM; i++) {
 439   2                // 1. 正向激励
 440   2                P24 = 1;        
 441   2                P25 = 0;        
 442   2                Delay_us(800);  
 443   2                 adc_fwd = ADC_Read_Channel(1); // 读取正向ADC
 444   2      
 445   2                // 2. 反向去极化
 446   2                P24 = 0; 
 447   2                P25 = 1; 
 448   2                Delay_us(800);  
 449   2                 adc_rev = ADC_Read_Channel(1); // 读取反向ADC
 450   2      
 451   2                // 3. 彻底断电
 452   2                P24 = 0;
 453   2                P25 = 0;
 454   2                
 455   2                // 理论上 adc_fwd + adc_rev 应该约等于 4095。
 456   2                // 使用双向数据可以消除内部基准电压偏移。
 457   2                // 如果继续沿用原来的正向算法，可以用 4095 - adc_rev 来代替 adc_fwd，或者求平均：
 458   2                tds_samples[i] = (adc_fwd + (4095 - adc_rev)) / 2;
 459   2            }
 460   1          // ========================================================
 461   1          // [升级] 冒泡排序 + 去极值平均滤波
 462   1          // ========================================================
 463   1          for (i = 0; i < TDS_SAMPLE_NUM - 1; i++) {
 464   2              for (j = i + 1; j < TDS_SAMPLE_NUM; j++) {
 465   3                  if (tds_samples[i] > tds_samples[j]) {
 466   4                      temp_swap = tds_samples[i];
 467   4                      tds_samples[i] = tds_samples[j];
 468   4                      tds_samples[j] = temp_swap;
 469   4                  }
 470   3              }
 471   2          }
 472   1          
 473   1          // 剔除前 2 个最小值 (下标 0, 1) 和后 2 个最大值 (下标 8, 9)
 474   1          // 取中间 6 个值求和算平均 (下标 2 到 7)
 475   1          for (i = 2; i < TDS_SAMPLE_NUM - 2; i++) {
 476   2              tds_sum += tds_samples[i];
 477   2          }
 478   1          adc_val = (uint16_t)(tds_sum / (TDS_SAMPLE_NUM - 4)); 
 479   1      //        printf("Filtered TDS ADC: %u\r\n", adc_val);
 480   1      
 481   1          // ========================================================
 482   1          // i. 水质判定
 483   1          // ========================================================
 484   1              // 执行带有温度补偿的水质算法
 485   1              cached_tds_ppm = Convert_ADC_To_TDS_ppm(adc_val, cached_temperature_c);       
 486   1                  
 487   1              if (cached_tds_ppm < TDS_GOOD_THRESHOLD) {
C51 COMPILER V9.60.7.0   HAL_ADC                                                           10/20/2026 16:39:30 PAGE 9   

 488   2                  cached_water_quality = WATER_GOOD;
 489   2              } else {
 490   2                  cached_water_quality = WATER_BAD;
 491   2              }
 492   1      }
 493          
 494          
 495          //低功耗部分代码
 496          /*
 497           * 低功耗单次读取。
 498           * 返回1：成功；返回0：转换超时。
 499           */
 500          static uint8_t ADC_PowerReadOnce(uint8_t channel,
 501                                           uint16_t *value)
 502          {
 503   1          uint16_t timeout;
 504   1      
 505   1          ADCCON = 0x80 | (channel & 0x0F);
 506   1          Delay_us(20);
 507   1      
 508   1          ADCCON = 0xC0 | (channel & 0x0F);
 509   1      
 510   1          timeout = 500;
 511   1      
 512   1          while (!(ADCCON & 0x20)) {
 513   2              if (--timeout == 0) {
 514   3                  ADCCON = 0x80 | (channel & 0x0F);
 515   3                  return 0;
 516   3              }
 517   2          }
 518   1      
 519   1          *value = ((uint16_t)ADCVH << 4) | (ADCVL >> 4);
 520   1      
 521   1          ADCCON = 0x80 | (channel & 0x0F);
 522   1      
 523   1          return 1;
 524   1      }
 525          
 526          
 527          /*
 528           * 切换通道后丢弃一次，再取三次平均。
 529           */
 530          static uint8_t ADC_PowerReadAverage(uint8_t channel,
 531                                              uint16_t *value)
 532          {
 533   1          uint8_t i;
 534   1          uint16_t sample;
 535   1          uint16_t sum;
 536   1      
 537   1          if (!ADC_PowerReadOnce(channel, &sample)) {
 538   2              return 0;
 539   2          }
 540   1      
 541   1          sum = 0;
 542   1      
 543   1          for (i = 0; i < 3; i++) {
 544   2              if (!ADC_PowerReadOnce(channel, &sample)) {
 545   3                  return 0;
 546   3              }
 547   2      
 548   2              sum += sample;
 549   2          }
C51 COMPILER V9.60.7.0   HAL_ADC                                                           10/20/2026 16:39:30 PAGE 10  

 550   1      
 551   1          *value = sum / 3;
 552   1      
 553   1          return 1;
 554   1      }
