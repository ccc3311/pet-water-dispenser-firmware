 265          /**
 266           * @brief  [新版三档算法] 计算并过滤电池电量档位
 267           * @param  voltage_mv:   ADC读取到的系统电压
 268           * @param  is_charging:  当前是否插着电源 (POWER_AC)
 269           * @param  pump_is_on:   当前水泵是否正在运行
 270           * @retval 映射后的电量百分比 (100:高, 50:中, 10:低)
 271           */
 272              uint8_t raw_tier;
 273              static uint8_t current_tier = 0xFF; // 当前正式档位 (0xFF代表开机未初始化)
 274              static uint8_t debounce_cnt = 0;    // 防抖计数器
 275          static uint8_t Calculate_Battery_Tier(uint16_t voltage_mv, uint8_t is_charging, uint8_t pump_is_on) {
 276   1          // 1. 动态硬件补偿 (维持原有优秀逻辑)
 277   1          if (!is_charging && pump_is_on) {
 278   2              voltage_mv += PUMP_SAG_MV_OFFSET;
 279   2          } else if (is_charging) {
 280   2              if (voltage_mv > CHARGE_RISE_MV_OFFSET) {
 281   3                  voltage_mv -= CHARGE_RISE_MV_OFFSET; 
 282   3              }
 283   2          }
 284   1      
 285   1          // 2. 【核心修复】：引入区间迟滞 (Hysteresis)，彻底消除跳档 Bug
 286   1            if (current_tier == 0xFF) {
 287   2                if (voltage_mv >= 3800U) {
 288   3                    raw_tier = BAT_TIER_HIGH; /* 高电量起点改为3.8V。 */
 289   3                } else if (voltage_mv >= 3600U) {
 290   3                    raw_tier = BAT_TIER_MID;
 291   3                } else {
 292   3                    raw_tier = BAT_TIER_LOW;  /* 3.6V以下进入提醒档，不直接决定停泵。 */
 293   3                }
 294   2            } else {
 295   2                raw_tier = current_tier;
 296   2      
 297   2                if (current_tier == BAT_TIER_HIGH) {
 298   3                    if (voltage_mv < 3800U) {
 299   4                        raw_tier = BAT_TIER_MID;
 300   4                    }
 301   3                }
C51 COMPILER V9.60.7.0   HAL_ADC                                                           10/20/2026 16:39:30 PAGE 6   

 302   2                else if (current_tier == BAT_TIER_MID) {
 303   3                    if (voltage_mv >= 3850U) {
 304   4                        raw_tier = BAT_TIER_HIGH; /* 回升保留50mV迟滞。 */
 305   4                    } else if (voltage_mv < 3600U) {
 306   4                        raw_tier = BAT_TIER_LOW;
 307   4                    }
 308   3                }
 309   2                else if (current_tier == BAT_TIER_LOW) {
 310   3                    if (voltage_mv >= 3650U) {
 311   4                        raw_tier = BAT_TIER_MID;  /* 回升保留50mV迟滞。 */
 312   4                    }
 313   3                }
 314   2            }
 315   1      
 316   1          // 3. 状态机防抖过滤
 317   1          if (current_tier == 0xFF) {
 318   2              current_tier = raw_tier;
 319   2              return current_tier;
 320   2          }
 321   1      
 322   1          // 只有连续 3 秒 (6 * 500ms) 稳定在新的 raw_tier 才确认切换
 323   1          if (raw_tier != current_tier) {
 324   2              debounce_cnt++;
 325   2              if (debounce_cnt >= 6) {
 326   3                  current_tier = raw_tier;
 327   3                  debounce_cnt = 0;
 328   3                  // HAL_Buzzer_Beep_3s(); // 如果需要档位切换鸣叫，解除注释
 329   3              }
 330   2          } else {
 331   2              debounce_cnt = 0; 
 332   2          }
 333   1      
 334   1          return current_tier;
 335   1      }
 336          /**
 337           * @brief  底层单次 ADC 读取函数 (阻塞式)
 338           * @param  channel: 对应 AINx 的通道号 (例如 AIN4 传 4)
 339           * @retval 12 位 ADC 转换结果 (0~4095)
 340           */
 341          static uint16_t ADC_Read_Channel(uint8_t channel) {
 342   1          uint16_t adc_result = 0;
 343   1          uint16_t timeout_cnt = 500; // 防卡死超时计数器 (根据主频微调，确保大于硬件转换时间)    
 344   1        
 345   1          // 1. 暴力切通道，绝不使用 |= ！
 346   1          // 0x80 就是二进制 1000 0000，确保 ADCEN=1, ADCSTA=0, EOC=0
 347   1          ADCCON = 0x80 | (channel & 0x0F);
 348   1          
 349   1          // 2. ！！！核心修复：给高阻抗电路充足的采样保持时间 ！！！
 350   1          // 100k 的外部电阻，RC 常数较大，我们给它足足 50 微秒的充电时间！
 351   1          // 这样能彻底阻断上一个通道留下的“残影电荷”
 352   1          Delay_us(20);
 353   1          
 354   1          // 3. 暴力启动转换！
 355   1          // 0xC0 就是二进制 1100 0000，确保 ADCEN=1, ADCSTA=1 (启动), EOC=0
 356   1          ADCCON = 0xC0 | (channel & 0x0F);
 357   1          
 358   1          // 4. 等待硬件回应 (加入防跑飞超时)
 359   1          while (!(ADCCON & 0x20)) {
 360   2              if (--timeout_cnt == 0) {
 361   3                  // 超时退出！说明硬件 ADC 模块可能受干扰死锁
 362   3                  ADCCON = 0x80 | (channel & 0x0F); // 强行复位 ADC 状态
 363   3                  s_adc_read_failed = 1;
C51 COMPILER V9.60.7.0   HAL_ADC                                                           10/20/2026 16:39:30 PAGE 7   

 364   3                  return 0;
 365   3              }
 366   2          }
 367   1          
 368   1          // 5. 硬件已置位 EOC，数据已准备好，立即读取！
 369   1      //    adc_result = ((uint16_t)(ADCVH & 0x0F) << 8) | ADCVL;
 370   1          adc_result = ((uint16_t)ADCVH << 4) | (ADCVL >> 4);    
 371   1          // 6. 暴力清零 EOC，恢复到待命状态
 372   1          ADCCON = 0x80 | (channel & 0x0F);
 373   1          
 374   1          return adc_result;
 375   1      }
