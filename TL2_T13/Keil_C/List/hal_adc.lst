  76          
  77          // --- 硬件参数配置 ---
  78          #define NTC_PULLUP_RESISTOR_OHM     510000UL  // R13 上拉电阻: 510K
  79          #define NTC_NOMINAL_RESISTANCE_OHM  100000UL  // NTC 标称阻值: 100K (25℃时)
  80          
  81          // --- 100K B=3950 NTC 标准阻值表 ---
  82          // 格式: { 温度(℃), 阻值(欧姆) }
  83          // 使用 uint32_t 存储，最大 32 万，不会溢出
  84          typedef struct {
  85              int8_t temp;
  86              uint32_t resistance;
  87          } NTC_Res_Table_t;
  88          
  89          static const NTC_Res_Table_t NTC_RES_LUT[] = {
  90              {0,   326500UL}, 
  91              {10,  200800UL}, 
  92              {20,  126300UL}, 
  93              {25,  100000UL}, // 25度基准点
  94              {30,  79900UL}, 
  95              {40,  51300UL}, 
  96              {50,  33600UL}, 
  97              {60,  22500UL}, 
  98              {70,  15400UL}, 
