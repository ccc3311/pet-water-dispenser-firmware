 178          // ==========================================
 179          // TDS 物理常量与标定参数配置
 180          // ==========================================
 181          #define R_FIXED              1500UL   // 硬件分压电阻阻值 (Ω)
 182          #define CELL_CONSTANT         2175000UL  // 电导池常数 (放大 10^6 倍)//1179381UL   513385UL
 183          
 184          #define TDS_COEFFICIENT      55UL     // TDS 转换系数 (0.55 的 100 倍)
 185          
 186          /**
 187           * @brief  [纯整数物理模型版] TDS 转换算法
 188           * @param  adc_val: 滤波后的正反交替差分 ADC 值 (0~4095)
 189           * @param  temp_c:  实时水温 (摄氏度)
 190           * @retval 补偿到 25℃ 时的真实 TDS PPM 值 (0~999)
 191           */
 192          static uint16_t Convert_ADC_To_TDS_ppm(uint16_t adc_val, int8_t temp_c) {
 193   1          uint32_t r_probe;       // 水体物理电阻 (Ω)
 194   1          uint32_t conductivity;  // 未补偿电导率 (μS/cm)
 195   1          uint32_t ec25;          // 25℃ 等效标准电导率 (μS/cm)
 196   1          uint16_t tds_ppm;
 197   1          int16_t  temp_coef;     // 温度补偿系数 (放大 100 倍)
 198   1      
 199   1          // 1. 探空与防呆保护 (离水或极纯水)
 200   1          if (adc_val >= 4000) {  
 201   2              return 0;
 202   2          }
 203   1          if (adc_val == 0) {     
 204   2              adc_val = 1;
 205   2          }
 206   1      
 207   1          // 2. 计算溶液物理电阻 R_probe (单位: Ω)
 208   1          // ！！！核心修复：翻转了分子与分母，匹配探针接地端的硬件模型 ！！！
 209   1          // 公式: R_probe = (R_FIXED * ADC) / (4095 - ADC)
 210   1          r_probe = (R_FIXED * (uint32_t)adc_val) / (4095UL - (uint32_t)adc_val);
 211   1          if (r_probe == 0) r_probe = 1;
 212   1      
 213   1          // 3. 计算实时物理电导率 (单位: μS/cm)
 214   1          // 公式: conductivity = CELL_CONSTANT / R_probe
 215   1          conductivity = CELL_CONSTANT / r_probe;
 216   1      
 217   1          // 4. 温度补偿 (统一折算到 25℃)
 218   1          // 补偿公式系数: 100 + 2 * (T - 25)
 219   1          temp_coef = 100 + 2 * ((int16_t)temp_c - 25);
 220   1          if (temp_coef < 10) temp_coef = 10; // 防极寒温度下分母过小
 221   1      
 222   1          // 计算补偿后的电导率
 223   1          // 溢出验证: conductivity 通常在 1000 以内，乘 100 为十万级，uint32_t 绝对安全
 224   1          ec25 = (conductivity * 100UL) / (uint32_t)temp_coef;
 225   1      
 226   1          // 5. 转换为最终的 TDS PPM 值
 227   1          // 公式: TDS = (EC25 * 55) / 100
 228   1          // 溢出验证: EC25 * 55 同样在百万级别，不会溢出
 229   1          tds_ppm = (uint16_t)((ec25 * TDS_COEFFICIENT) / 100UL); 
 230   1          // ========================================================
 231   1          // [新增] 基于实测数据的线性拟合校准 (y = 0.93x - 8)
 232   1          // 修正因探针间距误差、PCB走线寄生电容带来的系统性偏移
 233   1          // ========================================================
 234   1          {
 235   2              uint32_t calibrated_tds = ((uint32_t)tds_ppm * 93) / 100; // 乘以 0.93 的斜率
 236   2              if (calibrated_tds > 8) {
 237   3                  tds_ppm = (uint16_t)(calibrated_tds - 8); // 减去 8 的截距偏移
 238   3              } else {
 239   3                  tds_ppm = 0; // 防跌落为负数
C51 COMPILER V9.60.7.0   HAL_ADC                                                           10/20/2026 16:39:30 PAGE 5   

 240   3              }
 241   2          }
 242   1          // 6. UI 显示限幅保护
 243   1          if (tds_ppm > 999) tds_ppm = 999;
 244   1      
 245   1          return tds_ppm;
 246   1      }
