 164          /**
 165           * @brief  TIMER3中断初始化
 166           * @param  NewState[in]: 断使能/关闭选择
 167           *              - DISABLE:关闭
 168           *              - ENABLE:使能
 169           * @param  Priority[in]: 中断优先级选择
 170           *              - LOW:低
 171           *              - HIGH:高
 172           * @retval None
 173           */
 174          void TIM3_ITConfig(FunctionalState NewState, PriorityStatus Priority)
 175          {
C51 COMPILER V9.60.7.0   SC92F_TIMER3                                                      10/13/2026 10:46:34 PAGE 4   

 176   1        TXINX = 0x03;
 177   1      
 178   1        if(NewState == DISABLE)
 179   1        {
 180   2          IE1 &= 0XBF;
 181   2        }
 182   1        else
 183   1        {
 184   2          IE1 |= 0X40;
 185   2        }
 186   1      
 187   1        if(Priority == LOW)
 188   1        {
 189   2          IP1 &= 0XBF;
 190   2        }
 191   1        else
 192   1        {
 193   2          IP1 |= 0X40;
 194   2        }
 195   1      }
