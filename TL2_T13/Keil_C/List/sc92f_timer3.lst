 267          void TIM3_TimeBaseInit(TIM3_PresSel_TypeDef TIM3_PrescalerSelection,TIM3_CountMode_TypeDef TIM3_CountMode,
 268                                 TIM3_CountDirection_TypeDef TIM3_CountDirection)
 269          {
 270   1        TXINX = 0x03;
 271   1      
 272   1        if(TIM3_PrescalerSelection == TIM3_PRESSEL_FSYS_D12)
 273   1        {
 274   2          TXMOD &= 0X7F;
 275   2        }
 276   1        else
