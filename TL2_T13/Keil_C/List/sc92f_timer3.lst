 118          void TIM3_WorkMode1Config(uint16_t TIM3_SetCounter)
 119          {
 120   1        TXINX = 0x03;
 121   1        RCAPXL = TIM3_SetCounter % 256;
 122   1        RCAPXH = TIM3_SetCounter / 256;
 123   1      
 124   1        TLX = RCAPXL;
 125   1        THX = RCAPXH;
 126   1      }
