  56          /**
  57           * @brief  TIMER3相关寄存器复位至缺省值
  58           * @param  None
  59           * @retval None
  60           */ 
  61          void TIM3_DeInit()
  62          {
  63   1        TXINX = 0x03;    //TIMER3 选择
  64   1        TXCON = 0X00;
  65   1        TXMOD = 0X00;
  66   1        RCAPXH = 0X00;
  67   1        RCAPXL = 0X00;
  68   1        THX = 0X00;
  69   1        TLX = 0X00;
  70   1        IE1 &= 0X3F;
  71   1        IP1 &= 0X3F;
  72   1        ET2 = 0;
  73   1        IPT2 = 0;
  74   1      }
  75          
  76          #if defined(SC92F84Hx) || defined(SC92F83Hx)
              /**
               * @brief  TIM3引脚选择
               * @param  PinSeletion[in]:选择TIM3引脚
               *          - TIM3_PinRemap_Default:TIM3引脚为默认引脚
               *          - TIM3_PinRemap_A:TIM3引脚为A组引脚
               * @retval None
               */
              void TIM3_PinSelection(TIM3_PinSelection_TypeDef
                                      PinSeletion)
              {
                TMCON = TMCON & 0XEF | PinSeletion;
              }
              #endif
