  96           * @retval None
  97           */
  98          void TIM3_PrescalerSelection(TIM3_PresSel_TypeDef TIM3_PrescalerSelection)
  99          {
 100   1        TXINX = 0x03;
 101   1      
 102   1        if(TIM3_PrescalerSelection == TIM3_PRESSEL_FSYS_D12)
 103   1        {
 104   2          TXMOD &= 0X7F;
 105   2        }
 106   1        else
 107   1          if(TIM3_PrescalerSelection == TIM3_PRESSEL_FSYS_D1)
 108   1          {
 109   2            TXMOD |= 0X80;
 110   2          }
 111   1      }
