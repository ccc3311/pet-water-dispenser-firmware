 197          /**
 198           * @brief  获得TIMER3中断标志状态
 199           * @param  TIM3_Flag[in]:待读取的FLAG标志
 200           *              - TIM3_FLAG_TF3:中断标志位TF3
 201           *              - TIM3_FLAG_EXF3:中断标志位EXF3
 202           * @retval TIMER3中断标志状态
 203           *                  - RESET:置零
 204           *                  - SET:置起
 205           */ 
 206          FlagStatus TIM3_GetFlagStatus(TIM3_Flag_TypeDef TIM3_Flag)
 207          {
 208   1        unsigned char TXINX_Stack = TXINX;
 209   1        FlagStatus status = RESET;
 210   1        TXINX = 0x03;
 211   1      
 212   1        if((TIM3_Flag & TXCON) != (uint8_t)RESET)
 213   1        {
 214   2          status = SET;
 215   2        }
 216   1        else
 217   1        {
 218   2          status = RESET;
 219   2        }
 220   1        TXINX = TXINX_Stack;
 221   1        return status;
 222   1      }
 223          
 224          /**
 225           * @brief  清除TIMER3中断标志状态
 226           * @param  TIM3_Flag[in]:待读取的FLAG标志
 227           *              - TIM3_FLAG_TF3:中断标志位TF3
 228           *              - TIM3_FLAG_EXF3:中断标志位EXF3
 229           * @retval None
 230           */
 231          void TIM3_ClearFlag(TIM3_Flag_TypeDef TIM3_Flag)
 232          {
 233   1        unsigned char TXINX_Stack = TXINX;
 234   1        TXINX = 0x03;
 235   1        TXCON &= (~TIM3_Flag);
 236   1        TXINX = TXINX_Stack;
 237   1      }
