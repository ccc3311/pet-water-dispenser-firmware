  55          /**
  56           * @brief  TIMER4相关寄存器复位至缺省值
  57           * @param  None
  58           * @retval None
  59           */
  60          void TIM4_DeInit()
  61          {
  62   1        TXINX = 0x04; //TIMER4 选择
  63   1        TXCON = 0X00;
  64   1        TXMOD = 0X00;
  65   1        RCAPXH = 0X00;
  66   1        RCAPXL = 0X00;
  67   1        THX = 0X00;
  68   1        TLX = 0X00;
  69   1        IE1 &= 0X3F;
  70   1        IP1 &= 0X3F;
  71   1        ET2 = 0;
  72   1        IPT2 = 0;
  73   1      }
  74          
  75          /**
  76           * @brief  TIMER4 预分频选择
  77           * @param  TIM4_PrescalerSelection[in]:预分频选择
  78           *          - TIM4_PRESSEL_FSYS_D12:TIMER4计数源来自系统时钟12分频
  79           *          - TIM4_PRESSEL_FSYS_D1:TIMER4计数源来自系统时钟
  80           * @retval None
  81           */
  82          void TIM4_PrescalerSelection(TIM4_PresSel_TypeDef TIM4_PrescalerSelection)
  83          {
  84   1        TXINX = 0x04;
  85   1      
  86   1        if (TIM4_PrescalerSelection == TIM4_PRESSEL_FSYS_D12)
  87   1        {
  88   2          TXMOD &= 0X7F;
  89   2        }
  90   1        else if (TIM4_PrescalerSelection == TIM4_PRESSEL_FSYS_D1)
  91   1        {
  92   2          TXMOD |= 0X80;
  93   2        }
  94   1      }
  95          
  96          /**
  97           * @brief  TIMER4工作模式1配置函数
  98           * @param  TIM4_SetCounter[in]:配置计数初值
  99           * @retval None
 100           */ 
 101          void TIM4_WorkMode1Config(uint16_t TIM4_SetCounter)
 102          {
 103   1        TXINX = 0x04;
 104   1        RCAPXL = TIM4_SetCounter % 256;
 105   1        RCAPXH = TIM4_SetCounter / 256;
 106   1      
 107   1        TLX = RCAPXL;
 108   1        THX = RCAPXH;
 109   1      }
 110          
