 115           *              - ENABLE:使能
 116           * @retval None
 117           */ 
 118          void TIM4_Cmd(FunctionalState NewState)
 119          {
 120   1        TXINX = 0x04;
 121   1      
 122   1        if (NewState == DISABLE)
 123   1        {
 124   2          TRX = 0;
 125   2        }
