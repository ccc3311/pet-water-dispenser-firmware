 147          /**
 148           * @brief  TIMER4中断初始化
 149           * @param  NewState[in]: 断使能/关闭选择
 150           *              - DISABLE:关闭
 151           *              - ENABLE:使能
 152           * @param  Priority[in]: 中断优先级选择
 153           *              - LOW:低
 154           *              - HIGH:高
 155           * @retval None
 156           */
 157          void TIM4_ITConfig(FunctionalState NewState, PriorityStatus Priority)
 158          {
 159   1        TXINX = 0x04;
 160   1      
 161   1        if (NewState == DISABLE)
 162   1        {
 163   2          IE1 &= 0X7F;
 164   2        }
 165   1        else
 166   1        {
 167   2          IE1 |= 0X80;
 168   2        }
 169   1      
 170   1        if (Priority == LOW)
 171   1        {
 172   2          IP1 &= 0X7F;
 173   2        }
 174   1        else
 175   1        {
 176   2          IP1 |= 0X80;
C51 COMPILER V9.60.7.0   SC92F_TIMER4                                                      10/13/2026 10:46:34 PAGE 4   

 177   2        }
 178   1      }
 179          
 180          /**
 181           * @brief  TIM4_GetFlagStatus
 182           * @param  TIM4_Flag[in]:待读取的FLAG标志
 183           *              - TIM4_FLAG_TF4:中断标志位TF4
 184           *              - TIM4_FLAG_EXF4:中断标志位EXF4
 185           * @retval TIMER4中断标志状态
 186           *                  - RESET:置零
 187           *                  - SET:置起
 188           */ 
 189          FlagStatus TIM4_GetFlagStatus(TIM4_Flag_TypeDef TIM4_Flag)
 190          {
 191   1        unsigned char TXINX_Stack = TXINX;
 192   1        FlagStatus status = RESET;
 193   1        TXINX = 0x04;
 194   1      
 195   1        if ((TIM4_Flag & TXCON) != (uint8_t)RESET)
 196   1        {
 197   2          status = SET;
 198   2        }
 199   1        else
 200   1        {
 201   2          status = RESET;
 202   2        }
 203   1        TXINX = TXINX_Stack;
 204   1        return status;
 205   1      }
 206          
 207          /**
 208           * @brief  清除TIMER4中断标志状态
 209           * @param  TIM4_Flag[in]:待读取的FLAG标志
 210           *              - TIM4_FLAG_TF4:中断标志位TF4
 211           *              - TIM4_FLAG_EXF4:中断标志位EXF4
 212           * @retval None
 213           */
 214          void TIM4_ClearFlag(TIM4_Flag_TypeDef TIM4_Flag)
 215          {
 216   1        unsigned char TXINX_Stack = TXINX;
 217   1        TXINX = 0x04;
 218   1        TXCON &= (~TIM4_Flag);
 219   1        TXINX = TXINX_Stack;
 220   1      }
