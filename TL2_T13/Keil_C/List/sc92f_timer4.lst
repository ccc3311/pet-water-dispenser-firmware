 310           * @param  TIM4_SetCounter[in]:TIMER4计数初值配置
 311           * @retval None
 312           */ 
 313          void TIM4_WorkModeConfig(TIM4_WorkMode_TypeDef TIM4_WorkMode, uint16_t TIM4_SetCounter)
 314          {
 315   1        switch (TIM4_WorkMode)
 316   1        {
 317   2        case TIM4_WORK_MODE0:
 318   2          TIM4_WorkMode0Config(TIM4_SetCounter);
 319   2          break;
 320   2      
 321   2        case TIM4_WORK_MODE1:
 322   2          TIM4_WorkMode1Config(TIM4_SetCounter);
 323   2          break;
 324   2      
 325   2        case TIM4_WORK_MODE3:
 326   2          TIM4_WorkMode3Config(TIM4_SetCounter);
 327   2          break;
 328   2      
 329   2        default:
 330   2          break;
 331   2        }
 332   1      }
