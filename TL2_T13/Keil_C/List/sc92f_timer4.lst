 237          /**
 238           * @brief  TIM4基本设置配置函数
C51 COMPILER V9.60.7.0   SC92F_TIMER4                                                      10/13/2026 10:46:34 PAGE 5   

 239           * @param  TIM4_PrescalerSelection[in]:预分频选择
 240           *          - TIM4_PRESSEL_FSYS_D12:TIMER3计数源来自系统时钟12分频
 241           *          - TIM4_PRESSEL_FSYS_D1:TIMER3计数源来自系统时钟
 242           * @param  TIM4_CountMode[in]:计数/定时模式选择
 243           *          - TIM4_MODE_TIMER:TIMER4做定时器
 244           *          - TIM4_MODE_COUNTER:TIMER4做计数器
 245           * @param  TIM4_CountDirection[in]:计数/定时模式选择
 246           *          - TIM4_COUNTDIRECTION_UP:向上计数模式
 247           *          - TIM4_COUNTDIRECTION_DOWN_UP:向上/向下计数模式
 248           * @retval None
 249           */
 250          void TIM4_TimeBaseInit(TIM4_PresSel_TypeDef TIM4_PrescalerSelection,TIM4_CountMode_TypeDef TIM4_CountMode,
 251                                 TIM4_CountDirection_TypeDef TIM4_CountDirection)
 252          {
 253   1        TXINX = 0x04;
 254   1      
 255   1        TXMOD &= 0X7F;
 256   1        TXMOD = TIM4_PrescalerSelection<<7;
 257   1        
 258   1        if (TIM4_CountMode == TIM4_MODE_TIMER)
 259   1        {
 260   2          TXCON &= 0XFD;
 261   2        }
 262   1        else if (TIM4_CountMode == TIM4_MODE_COUNTER)
 263   1        {
 264   2          TXCON |= 0X02;
 265   2        }
 266   1      
 267   1        /************************************************************/
 268   1        if (TIM4_CountDirection == TIM4_COUNTDIRECTION_UP)
 269   1        {
 270   2          TXMOD &= 0XFE;
 271   2        }
 272   1        else if (TIM4_CountDirection == TIM4_COUNTDIRECTION_DOWN_UP)
 273   1        {
 274   2          TXMOD |= 0X01;
 275   2        }
 276   1      }
