 676          /*
 677           * 读取芯片寄存器，保存原始数据，并解析电源、充电和故障状态。
 678           * snapshot指向调用者提供的结构体，函数直接更新该结构体。
 679           *
 680           * 返回OK表示本轮读取和解析完成；中途失败时，快照可能仅部分更新，
 681           * 调用者应先检查返回值，再根据快照进行业务判断。
 682           */
 683          sc_u8 sc89601_read_snapshot(volatile sc89601_snapshot_t *snapshot)
 684          {
 685   1          sc_u8 result;
 686   1          sc_u8 reg;
 687   1          sc_u8 value;
 688   1      
 689   1          /* 未提供快照存储对象，不能继续访问其成员。 */
 690   1          if (snapshot == 0)
 691   1          {
 692   2              return SC89601_ERR_NULL;
 693   2          }
 694   1      
 695   1          /*
 696   1           * 按地址逐个读取寄存器，保存到MCU内的reg[]数组。
 697   1           * REG09具有故障锁存读取特性，留到后面单独连续读取。
 698   1           */
 699   1          for (reg = 0u; reg < SC89601_REG_COUNT; reg++)
 700   1          {
 701   2              if (reg == SC89601_REG_FAULT)
 702   2              {
 703   3                  continue;  /* 仅跳过当前地址，继续读取后续寄存器。 */
 704   3              }
 705   2      
 706   2              /*
 707   2               * result接收操作结果；寄存器读回的字节通过&value输出。
 708   2               * 读取失败立即返回，交给调用者处理通信异常。
 709   2               */
 710   2              result = sc89601_read_reg(reg, &value);
 711   2              if (result != SC89601_OK)
 712   2              {
 713   3                  return result;
 714   3              }
 715   2      
 716   2              /* 保存原始字节，供后面的字段解析和上层配置检查使用。 */
 717   2              snapshot->reg[reg] = value;
 718   2          }
 719   1      
 720   1          /*
 721   1           * REG09连续读取两次：
 722   1           * 第一次保存此前锁存的故障状态，不代表故障此刻仍然存在。
 723   1           * 第二次取得当前故障状态。
 724   1           */
 725   1          result = sc89601_read_reg(SC89601_REG_FAULT, &value);
 726   1          if (result != SC89601_OK)
 727   1          {
 728   2              return result;
 729   2          }
 730   1          snapshot->fault_latched = value;
 731   1      
 732   1          result = sc89601_read_reg(SC89601_REG_FAULT, &value);
 733   1          if (result != SC89601_OK)
 734   1          {
 735   2              return result;
C51 COMPILER V9.60.7.0   SC89601                                                           10/22/2026 15:13:09 PAGE 13  

 736   2          }
 737   1          snapshot->fault_current = value;
 738   1      
 739   1          /* 原始寄存器数组也保存第二次读到的当前故障值。 */
 740   1          snapshot->reg[SC89601_REG_FAULT] = value;
 741   1      
 742   1          /*
 743   1           * 以下从已保存的原始字节中提取字段，不再进行I2C读取。
 744   1           * &保留目标位，右移则将字段移到最低位，便于上层比较。
 745   1           */
 746   1      
 747   1          /* DEVICE：bit6~3为芯片型号编码，bit1~0为版本编码。 */
 748   1          value = snapshot->reg[SC89601_REG_DEVICE];
 749   1          snapshot->part_number = (value & 0x78u) >> 3;
 750   1          snapshot->revision = value & 0x03u;
 751   1      
 752   1          value = snapshot->reg[SC89601_REG_STAT1];
 753   1      
 754   1          /* STAT1 bit7~5：输入源状态编码，0表示无输入。 */
 755   1          snapshot->vbus_status = (value & 0xE0u) >> 5;
 756   1      
 757   1          /*
 758   1           * STAT1 bit4~3：充电状态编码。
 759   1           * 0=未充电，1=小电流充电，2=快充，3=充电终止。
 760   1           */
 761   1          snapshot->charge_status = (value & 0x18u) >> 3;
 762   1      
 763   1          /* STAT1 bit2：输入电源是否就绪，0=未就绪，1=就绪。 */
 764   1          snapshot->power_good = (value & 0x04u) >> 2;
 765   1      
 766   1          /*
 767   1           * STAT2 bit7：VBUS接入标志。
 768   1           * 上层RUNNING分支根据此字段判断是否转入等待输入。
 769   1           */
 770   1          value = snapshot->reg[SC89601_REG_STAT2];
 771   1          snapshot->vbus_good = (value & 0x80u) >> 7;
 772   1      
 773   1          /* CTL5 bit6：INPUT_DET_DONE，手册标为DP/DM识别完成状态。 */
 774   1          value = snapshot->reg[SC89601_REG_CTL5];
 775   1          snapshot->input_det_done = (value & 0x40u) >> 6;
 776   1      
 777   1          return SC89601_OK;
 778   1      }
