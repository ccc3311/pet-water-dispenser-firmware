  10          /*
  11           * 用户指定连线：
  12           *   SC92L7533 P1.6 -> SC89601 SCL
  13           *   SC92L7533 P1.7 -> SC89601 SDA
  14           *
  15           * SC92L7533 端口只有“输入/强推挽输出”，没有独立开漏模式。
  16           * I2C 低电平：数据锁存器写 0，再切为输出。
  17           * I2C 高电平：切为高阻输入，由原理图上的 10k 上拉到 3.3V。
  18           * 禁止把引脚配置为推挽输出高电平，否则可能与从机拉低发生冲突。
  19           */
  20          #define SC89601_SCL_MASK       0x40u
  21          #define SC89601_SDA_MASK       0x80u
  22          #define SC89601_I2C_MASK       0xC0u
  23          #define SC89601_SCL_IO         P16
  24          #define SC89601_SDA_IO         P17
