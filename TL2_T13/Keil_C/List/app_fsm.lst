 458   2          }
 459   1      
 460   1          /*
 461   1           * µ±Ç°Äê·ÝµÄ2ÔÂ²¹³¥¶ÀÁ¢´¦Àí£º
 462   1           * ÔÚÏÖÓÐÄê·Ý·¶Î§ÄÚ£¬Ö±½ÓÅÅ³ý2100¡¢2200£¬Ìæ´úÊÀ¼ÍÈ¡Ä£ÅÐ¶Ï¡£
 463   1           */
 464   1          if (month > 2U &&
 465   1              (year_since_2000 & 3U) == 0U &&
 466   1              year_since_2000 != 100U &&
 467   1              year_since_2000 != 200U) {
 468   2              days++;
 469   2          }
 470   1      
 471   1          days += (day - 1);
 472   1      
 473   1          return (days * 86400UL) +
 474   1                 ((unsigned long)hour * 3600UL) +
 475   1                 ((unsigned long)minute * 60UL) + second;
 476   1      }
