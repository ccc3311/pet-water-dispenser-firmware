 440   1      
 441   1          /*
 442   1           * 8Î»Äê·Ý¸²¸Ç2000¡«2255£¬2100¡¢2200ÎªÆ½Äê¡£
 443   1           * ÑÏ¸ñ´óÓÚ100/200Ê±£¬²Å¿Û³ýÒÑ¾­½áÊøµÄ¶ÔÓ¦ÊÀ¼ÍÄê¡£
 444   1           */
 445   1          if (year_since_2000 > 100U) {
 446   2              leap_years--;
 447   2          }
 448   1          if (year_since_2000 > 200U) {
 449   2              leap_years--;
 450   2          }
 451   1      
 452   1          /* °´32Î»¼ÆËãÕûÄêÌìÊý£¬±ÜÃâÄê·Ý³Ë365³¬³ö16Î»·¶Î§¡£ */
 453   1          days =
 454   1              (unsigned long)year_since_2000 * 365UL + leap_years;
 455   1      
 456   1          for (i = 0; i < month - 1; i++) {
