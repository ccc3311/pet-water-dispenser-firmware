 426          /**
 427           * @brief  UART初始化配置函数
 428           * @param  UARTFsys[in]:系统时钟频率
 429           * @param  BaudRate[in]:波特率
 430           * @param  Mode[in]:UART0工作模式
 431           *          - USCI1_UART_Mode_8B:UART设置为8位模式
 432           *          - USCI1_UART_Mode_10B:UART设置为10位模式
 433           *          - USCI1_UART_Mode_11B:UART设置为11位模式
 434           * @param  RxMode[in]:接收允许选择
 435           *          - USCI1_UART_RX_ENABLE:UART允许接收
 436           *          - USCI1_UART_RX_DISABLE:UART禁止接收
 437           * @retval None
 438           */
 439          void USCI1_UART_Init(uint32_t UARTFsys, uint32_t BaudRate, USCI1_UART_Mode_TypeDef Mode,
 440                               USCI1_UART_RX_TypeDef RxMode)
 441          {
 442   1        OTCON |= 0xC0;
 443   1        US1CON0 = US1CON0 & 0X0F | Mode | RxMode;
 444   1      
 445   1        if (Mode == USCI1_UART_Mode_8B)
 446   1        {
 447   2          if (BaudRate == USCI1_UART_BaudRate_FsysDIV12)
 448   2          {
 449   3            US1CON0 &= 0XDF;
 450   3          }
 451   2          else if (BaudRate == USCI1_UART_BaudRate_FsysDIV4)
 452   2          {
 453   3            US1CON0 |= 0X20;
 454   3          }
 455   2        }
 456   1        else
 457   1        {
 458   2          US1CON2 = UARTFsys / BaudRate / 256;
 459   2          US1CON1 = UARTFsys / BaudRate % 256;
 460   2        }
 461   1      }
