 552           *              - USCI1_SPI_FLAG_SPIF:SPI数据传送标志位SPIF
 553           *              - USCI1_SPI_FLAG_WCOL:SPI写入冲突标志位WCOL
 554           *              - USCI1_SPI_FLAG_TXE:SPI发送缓存器空标志TXE
 555           *              - USCI1_TWI_FLAG_TWIF:TWI中断标志位TWIF
 556           *              - USCI1_TWI_FLAG_GCA:TWI通用地址响应标志位GCA
 557           *              - USCI1_TWI_FLAG_MSTR:TWI主从标志位MSTR
 558           *              - USCI1_TWI_FLAG_TXRXnE:TWI发送接收标志位
 559           *              - USCI1_UART_FLAG_RI:UART发送中断标志位TI
 560           *              - USCI1_UART_FLAG_TI:UART接收中断标志位RI
 561           * @retval USCI1标志状态
 562           *              - RESET:置零
 563           *              - SET:置起
 564           */
 565          FlagStatus USCI1_GetFlagStatus(USCI1_Flag_TypeDef USCI1_FLAG)
 566          {
 567   1        FlagStatus bitstatus = RESET;
 568   1      #if defined(SC92L853x) || defined(SC92L753x) || defined(SC92F646x) || defined(SC92F546x) || defined(SC92F5
             -42x)|| defined(SC92L840x)
 569   1        if ((USCI1_FLAG == USCI1_SPI_FLAG_SPIF) || (USCI1_FLAG == USCI1_SPI_FLAG_WCOL) || (USCI1_FLAG == USCI1_T
             -WI_FLAG_TXRXnE))
 570   1      #endif
 571   1          {
 572   2            if ((USCI1_FLAG & US1CON1) != (uint8_t)RESET)
 573   2            {
 574   3              bitstatus = SET;
 575   3            }
 576   2            else
 577   2            {
 578   3              bitstatus = RESET;
 579   3            }
 580   2          }
 581   1          else
 582   1          {
 583   2            if ((USCI1_FLAG & US1CON0) != (uint8_t)RESET)
 584   2            {
 585   3              bitstatus = SET;
 586   3            }
 587   2            else
 588   2            {
 589   3              bitstatus = RESET;
 590   3            }
 591   2          }
 592   1      
 593   1        return bitstatus;
 594   1      }
