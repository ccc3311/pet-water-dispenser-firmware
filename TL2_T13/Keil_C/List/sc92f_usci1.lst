 133           * @param  TransmissionMode[in]:TransmissionMode
 134           *          - USCI1_SPI_DATA8:SPI 8位传输模式
 135           *          - USCI1_SPI_DATA16:SPI 16位传输模式
 136           * @retval None
 137           */ 
 138          void USCI1_TransmissionMode(USCI1_TransmissionMode_TypeDef TransmissionMode)
 139          {
 140   1        OTCON =(OTCON & 0XCF) | 0X10;
 141   1        if (TransmissionMode == USCI1_SPI_DATA8)
 142   1        {
 143   2          US1CON1 &= 0xFD;
 144   2        }
 145   1        else
 146   1        {
 147   2          US1CON1 |= 0x02;
 148   2        }
 149   1      }
