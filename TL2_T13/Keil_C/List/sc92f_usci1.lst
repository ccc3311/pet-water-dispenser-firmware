 488          void USCI1_UART_SendData9(uint16_t Data)
 489          {
 490   1        uint8_t Data_9Bit;
 491   1        Data_9Bit = (Data >> 8);
 492   1      
 493   1        if (Data_9Bit)
 494   1        {
