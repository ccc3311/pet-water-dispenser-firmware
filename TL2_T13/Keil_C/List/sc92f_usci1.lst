  60          void USCI1_DeInit(void)
  61          {
  62   1        OTCON &= 0X3F;
  63   1        US1CON0 = 0X00;
  64   1        US1CON1 = 0X00;
  65   1        US1CON2 = 0X00;
  66   1        US1CON3 = 0X00;
