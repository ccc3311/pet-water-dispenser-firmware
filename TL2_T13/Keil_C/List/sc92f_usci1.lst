 192          /**
 193           * @brief  US1CON2 SPI发送数据
 194           * @param  Data[in]:发送的数据
 195           * @retval None
 196           */
 197          void USCI1_SPI_SendData_16(uint16_t Data)
 198          {
 199   1        US1CON3 = (uint8_t)(Data >> 8);
 200   1        US1CON2 = (uint8_t)Data;
