 208          uint16_t USCI1_SPI_ReceiveData_16(void)
 209          {
 210   1        uint16_t SPI_data;
 211   1        SPI_data = ((uint16_t)US1CON3 << 8) | US1CON2;
 212   1        return SPI_data;
 213   1      }
