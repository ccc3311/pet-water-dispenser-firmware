                   */
                  TUYA_UNUSED(cmd);
                  TUYA_UNUSED(expected_len);
                  return PROCESS_BUFFER_OVERFLOW_HANDLE_METHOD_DISCARD_CURRENT_AND_RX_BUFFER;
              }
              
              bool_t on_first_command_after_overflow(const u8* frame, u16 frame_len) {
                  /**
                   * 在生产环境下，缓冲区溢出可能预示潜在的攻击
