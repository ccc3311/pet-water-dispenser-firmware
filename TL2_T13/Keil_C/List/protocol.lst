 303          static void App_DpApplyWorkMode(uint8_t target)
 304          {
 305   1          /* 合并两个回调的本地模式处理，DP校验和回传由各入口完成。 */
 306   1          if (g_Device.state != STATE_OFF) {
 307   2              if (target == 1 && g_Device.power_mode != POWER_AC) {
 308   3                  HAL_Buzzer_Beep(2);
 309   3              } else {
 310   3                  g_Device.target_work_mode = target;
 311   3      
 312   3                  if (g_Device.state == STATE_IDLE ||
 313   3                      g_Device.state == STATE_SENSING ||
 314   3                      g_Device.state == STATE_CONTINUOUS) {
 315   4                      g_Device.state = (target == 1) ?
 316   4                          STATE_CONTINUOUS : STATE_IDLE;
 317   4                  }
 318   3      
 319   3                  g_Device.display_timer_s = 10;
 320   3                  HAL_Buzzer_Beep(1);
 321   3              }
 322   2          }
 323   1      }
