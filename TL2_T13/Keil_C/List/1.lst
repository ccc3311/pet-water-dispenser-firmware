  58          /*
  59           * 软件I2C的短延时，供每个SCL/SDA边沿使用。
  60           * volatile防止空循环被完全消除；实际总线速度仍取决于时钟和编译选项。
  61           */
  62          static void sc89601_i2c_delay(void)
  63          {
  64   1          volatile sc_u8 count;
  65   1      
  66   1          /*
  67   1           * 沿用现有延时计数，设计目标为低于100kHz的保守软件I2C时序。
  68   1           * 该延时不要求精确，只要求满足 I2C 最小时序。
  69   1           */
  70   1          count = 60u;
  71   1          while (count != 0u)
  72   1          {
  73   2              count--;
  74   2          }
  75   1      }
  76          
  77          /*
  78           * 粗略等待接口，当前用于寄存器复位后的短暂等待。
  79           * ms表示名义等待量；不用它驱动业务秒时钟或看门狗计时。
  80           */
  81          void sc89601_delay_ms(sc_u16 ms)
  82          {
  83   1          sc_u16 count;
  84   1      
  85   1          /* 仅用于上电等待和轮询节拍，不作为精确定时基准。 */
  86   1          while (ms != 0u)
  87   1          {
  88   2              count = 100u;
  89   2              while (count != 0u)
  90   2              {
  91   3                  sc89601_i2c_delay();
  92   3                  count--;
  93   3              }
  94   2              ms--;
  95   2          }
  96   1      }
  97          
  98          /* 模拟开漏拉低SCL：先写0，再设为输出，避免切换方向时短暂输出高电平。 */
  99          static void sc89601_scl_drive_low(void)
 100          {
 101   1          SC89601_SCL_IO = 0;
 102   1          /* P1CON对应位为1表示输出；这里只修改P1.6。 */
 103   1          P1CON |= SC89601_SCL_MASK;
 104   1      }
 105          
