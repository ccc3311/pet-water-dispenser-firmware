 107          static void sc89601_scl_release(void)
 108          {
 109   1          P1CON &= (sc_u8)(~SC89601_SCL_MASK);
 110   1      }
 111          
 112          /* 模拟开漏拉低SDA：先写0，再把P1.7切为输出。 */
 113          static void sc89601_sda_drive_low(void)
 114          {
 115   1          SC89601_SDA_IO = 0;
