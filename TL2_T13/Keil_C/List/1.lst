 116   1          P1CON |= SC89601_SDA_MASK;
 117   1      }
 118          
 119          /* 释放SDA为高阻输入，允许从机输出数据或ACK。 */
 120          static void sc89601_sda_release(void)
 121          {
 122   1          P1CON &= (sc_u8)(~SC89601_SDA_MASK);
 123   1      }
