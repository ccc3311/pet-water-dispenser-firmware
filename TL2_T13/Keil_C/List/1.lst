   1          /*
   2           * SC89601 充电 / OTG 升压驱动（本版只补充说明，执行逻辑与参数不变）。
   3           * 
   4           * 主程序调用顺序：
   5           * 1. 上电调用一次 sc89601_service_init()，建立 GPIO 和软件状态。
   6           * 2. 正常运行每100ms：先sc89601_set_otg_allowed()，再sc89601_service_100ms()。
   7           *    当前业务在电压已有采样且电量不是低档时允许 OTG；软件关机不单独禁止升压。
   8           * 3. BTM秒任务调用sc89601_tick_1s()，正常运行与MCU STOP巡检期间都要调用。
   9           * 4. STOP巡检调用sc89601_sleep_wake_required()；返回1后主程序恢复正常调度。
  10           * 
  11           * 模式选择：外部输入优先；无外部输入且业务允许时，电池 OTG 输出目标为 4.6V。
  12           * 有外部输入时先退出 OTG，输入识别有效后分步配置并使能充电。
  13           * 充电恒流、恒压和终止过程由芯片硬件执行，MCU 负责配置、巡检和喂狗。
  14           * 
  15           * 当前充电目标：输入限流 2800mA、VINDPM 8.4V、输入过压阈值 14.2V；
  16           * 充电 600mA / 4.2V、预充 300mA、终止 180mA，芯片看门狗 40 秒。
  17           * 芯片看门狗与 MCU 自身的 WDT 是两套机制；本文件只维护 SC89601 看门狗。
  18           * 
  19           * 硬件边界：SYS_MIN 调节的是 VSYS；它不会把适配器输入下的 PMID 固定为 4.6V。
  20           * 水泵最终供电电压由外部电源电路保证，水泵开关仍由原 HAL/FSM 控制。
  21           * 软件 I2C 和日志会占用主循环时间，所以本文件接口不放入中断中执行。
  22           */
  23          
  24          #include "sc89601.h"
  25          #include "SC_Init.h"
  26          #include "sc89601.h"
  27          #include <stdio.h>
  28          
  29          /*
  30           * 用户指定连线：
  31           *   SC92L7533 P1.6 -> SC89601 SCL
  32           *   SC92L7533 P1.7 -> SC89601 SDA
  33           *
  34           * SC92L7533 端口只有“输入/强推挽输出”，没有独立开漏模式。
  35           * I2C 低电平：数据锁存器写 0，再切为输出。
  36           * I2C 高电平：切为高阻输入，由原理图上的 10k 上拉到 3.3V。
  37           * 禁止把引脚配置为推挽输出高电平，否则可能与从机拉低发生冲突。
  38           */
  39          #define SC89601_SCL_MASK       0x40u
  40          #define SC89601_SDA_MASK       0x80u
  41          #define SC89601_I2C_MASK       0xC0u
  42          #define SC89601_SCL_IO         P16
  43          #define SC89601_SDA_IO         P17
  44          #define SC89601_ADDR_WRITE     ((SC89601_I2C_ADDR_7BIT << 1) | 0u)
  45          #define SC89601_ADDR_READ      ((SC89601_I2C_ADDR_7BIT << 1) | 1u)
  46          /* SCL/SDA 的显示驱动输出位在 P1VO[4]/P1VO[5]。 */
  47          #define SC89601_P1VO_MASK      0x30u
  48          /* 等待SCL释放的循环上限；1000是循环次数，不是毫秒数。 */
  49          #define SC89601_SCL_WAIT_COUNT 1000u
  50          /* 芯片看门狗配置为40秒；每10个BTM秒节拍尝试喂一次，留出时间余量。 */
  51          #define SC89601_WDT_FEED_INTERVAL_S  10u
  52          
  53          /* 软件维护许可：只有芯片看门狗已配置且首次喂狗成功，才开始周期维护。 */
C51 COMPILER V9.60.7.0   1                                                                 10/07/2026 10:36:49 PAGE 2   

  54          static sc_u8 s_sc89601_wdt_enabled = 0u;
  55          /* 距离上次成功喂狗的BTM秒节拍计数；它不是芯片内部的倒计时寄存器。 */
  56          static sc_u8 s_sc89601_wdt_seconds = 0u;
