              /**
               * @brief  UART2÷–∂œ≥ı ºªØ
               * @param  NewState[in]: ∂œ πƒ‹/πÿ±’—°‘Ò
               *              - DISABLE:πÿ±’
               *              - ENABLE: πƒ‹
               * @param  Priority[in]: ÷–∂œ”≈œ»º∂—°‘Ò
               *              - LOW:µÕ
               *              - HIGH:∏ﬂ
               * @retval None
C51 COMPILER V9.60.7.0   SC92F_UART2                                                       10/13/2026 10:46:34 PAGE 19  

               */ 
              void UART2_ITConfig(FunctionalState NewState,
                                  PriorityStatus Priority)
              {
                if(NewState == DISABLE)
                {
                  IE2 &= 0XFE;
                }
                else
                {
                  IE2 |= 0X01;
                }
              
                //…Ë÷√÷–∂œ”≈œ»º∂
                if(Priority == LOW)
                {
                  IP2 &= 0XFE;
                }
                else
                {
                  IP2 |= 0X01;
                }
              }
              
              /**
               * @brief  «Â≥˝UART2±Í÷æ◊¥Ã¨
               * @param  UART2_FLAG[in]:À˘–Ë«Â≥˝µƒ±Í÷æŒª
               *              - UART2_FLAG_TI:UART2∑¢ÀÕ÷–∂œ±Í÷æŒªTI
               *              - UART2_FLAG_RI:UART2Ω” ’÷–∂œ±Í÷æŒªRI
               * @retval None
               */
              void UART2_ClearFlag(UART2_Flag_Typedef UART2_FLAG)
              {
                TMCON &= 0X7F;  //UARTøÿ÷∆ºƒ¥Ê∆˜÷∏’Î÷∏œÚUART2
                if(UART2_FLAG == UART2_FLAG_TI)
                {
                  UXCON &= (~UART2_FLAG_RI);
                }
                else
                {
                  UXCON &= (~UART2_FLAG_TI);
                }
              }
