              /**
               * @brief  UART2œ‡πÿºƒ¥Ê∆˜∏¥Œª÷¡»± °÷µ
               * @param  None
               * @retval None
               */ 
              void UART2_DeInit(void)
              {
                U2SCON = 0X00;
                IE &= 0XDF;
                IP &= 0XDF;
              }
              
              /**
               * @brief  UART2≥ı ºªØ≈‰÷√∫Ø ˝
               * @param  Uart2Fsys[in]:œµÕ≥ ±÷”∆µ¬ 
               * @param  BaudRate[in]:≤®Ãÿ¬ 
               * @param  Mode[in]:π§◊˜ƒ£ Ω
               *          - UART2_Mode_10B:UART2π§◊˜ƒ£ Ω:10Œª»´À´π§
               *          - UART2_Mode_11B:UART2π§◊˜ƒ£ Ω:11Œª»´À´π§
               * @param  RxMode[in]:Ω” ’‘ –Ì—°‘Ò
               *          - UART2_RX_ENABLE:‘ –ÌΩ” ’ ˝æ›
               *          - UART2_RX_DISABLE:≤ª‘ –ÌΩ” ’ ˝æ›
               * @retval None
               */
              void UART2_Init(uint32_t Uart2Fsys, 
                              uint32_t BaudRate,
                              UART2_Mode_Typedef Mode,
                              UART2_RX_Typedef RxMode)
              {
                U2SCON  = (U2SCON & 0X2F) | Mode | RxMode;  //…Ë÷√UARTπ§◊˜ƒ£ Ω,…Ë÷√Ω” ’‘ –ÌŒª
              
                /* ≈‰÷√UART2≤®Ãÿ¬  */
                U2BAUDH = (Uart2Fsys / BaudRate) / 256;
                U2BAUDL = (Uart2Fsys / BaudRate) % 256;
              }
              
              /**
               * @}
               */
