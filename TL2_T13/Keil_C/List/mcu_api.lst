  80          /**
  81           * @brief  把src所指内存区域的前count个字节设置成字符c
  82           * @param[out] {src} 待设置的内存首地址
  83           * @param[in] {ch} 设置的字符
  84           * @param[in] {count} 设置的内存长度
  85           * @return 待设置的内存首地址
  86           */
  87          void* tuya_memset(void* src, u8 ch, u16 count) {
  88   1          u8* tmp = (u8*)src;
  89   1      
  90   1          if (src == NULL) {
  91   2              return NULL;
  92   2          }
  93   1      
  94   1          while (count--) {
  95   2              *tmp++ = ch;
  96   2          }
  97   1      
  98   1          return src;
  99   1      }
