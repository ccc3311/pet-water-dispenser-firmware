 177          /**
 178           * @brief  将int类型拆分四个字节
 179           * @param[in] {number} 4字节原数据
 180           * @param[out] {value} 处理完成后4字节数据
 181           * @return Null
 182           */
 183          void int_to_byte(u32 number, u8 value[4]) {
 184   1          value[0] = number >> 24;
 185   1          value[1] = number >> 16;
 186   1          value[2] = number >> 8;
 187   1          value[3] = number & 0xff;
 188   1      }
 189          
 190          /**
 191           * @brief  将4字节合并为1个32bit变量
 192           * @param[in] {value} 4字节数组
 193           * @return 合并完成后的32bit变量
 194           */
 195          u32 byte_to_int(const u8 value[4]) {
 196   1          u32 nubmer = 0;
 197   1      
 198   1          nubmer = (u32)value[0];
 199   1          nubmer <<= 8;
 200   1          nubmer |= (u32)value[1];
 201   1          nubmer <<= 8;
 202   1          nubmer |= (u32)value[2];
 203   1          nubmer <<= 8;
 204   1          nubmer |= (u32)value[3];
 205   1      
 206   1          return nubmer;
 207   1      }
