 160          /**
 161           * @brief  字符串比较
 162           * @param[in] {s1} 字符串 1
 163           * @param[in] {s2} 字符串 2
 164           * @return 大小比较值
 165           * -         0:s1=s2
 166           * -         <0:s1<s2
 167           * -         >0:s1>s2
 168           */
 169          i32 tuya_strcmp(char* s1, char* s2) {
 170   1          while (*s1 && *s2 && *s1 == *s2) {
 171   2              s1++;
 172   2              s2++;
 173   2          }
 174   1          return *s1 - *s2;
 175   1      }
