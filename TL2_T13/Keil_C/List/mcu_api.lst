  31          /**
  32           * @brief  hex转bcd
  33           * @param[in] {Value_H} 高字节
  34           * @param[in] {Value_L} 低字节
  35           * @return 转换完成后数据
  36           */
  37          u8 hex_to_bcd(u8 Value_H, u8 Value_L) {
  38   1          u8 bcd_value;
  39   1      
  40   1          if ((Value_H >= '0') && (Value_H <= '9'))
  41   1              Value_H -= '0';
  42   1          else if ((Value_H >= 'A') && (Value_H <= 'F'))
  43   1              Value_H = Value_H - 'A' + 10;
  44   1          else if ((Value_H >= 'a') && (Value_H <= 'f'))
  45   1              Value_H = Value_H - 'a' + 10;
  46   1      
  47   1          bcd_value = Value_H & 0x0f;
  48   1      
  49   1          bcd_value <<= 4;
  50   1          if ((Value_L >= '0') && (Value_L <= '9'))
  51   1              Value_L -= '0';
  52   1          else if ((Value_L >= 'A') && (Value_L <= 'F'))
C51 COMPILER V9.60.7.0   MCU_API                                                           10/22/2026 15:13:09 PAGE 2   

  53   1              Value_L = Value_L - 'a' + 10;
  54   1          else if ((Value_L >= 'a') && (Value_L <= 'f'))
  55   1              Value_L = Value_L - 'a' + 10;
  56   1      
  57   1          bcd_value |= Value_L & 0x0f;
  58   1      
  59   1          return bcd_value;
  60   1      }
