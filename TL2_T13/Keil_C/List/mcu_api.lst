 101          /**
 102           * @brief  内存拷贝
 103           * @param[out] {dest} 目标地址
 104           * @param[in] {src} 源地址
 105           * @param[in] {count} 拷贝数据个数
 106           * @return 数据处理完后的源地址
 107           */
 108          void* tuya_memcpy(void* dest, const void* src, u16 count) {
 109   1          u8* pdest = (u8*)dest;
 110   1          const u8* psrc = (const u8*)src;
 111   1          u16 i;
 112   1      
 113   1          if (dest == NULL || src == NULL) {
 114   2              return NULL;
C51 COMPILER V9.60.7.0   MCU_API                                                           10/22/2026 15:13:09 PAGE 3   

 115   2          }
 116   1      
 117   1          if ((pdest <= psrc) || (pdest > psrc + count)) {
 118   2              for (i = 0; i < count; i++) {
 119   3                  pdest[i] = psrc[i];
 120   3              }
 121   2          } else {
 122   2              for (i = count; i > 0; i--) {
 123   3                  pdest[i - 1] = psrc[i - 1];
 124   3              }
 125   2          }
 126   1      
 127   1          return dest;
 128   1      }
