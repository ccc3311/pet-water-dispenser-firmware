  62          /**
  63           * @brief  求字符串长度
  64           * @param[in] {str} 字符串地址
  65           * @return 数据长度
  66           */
  67          u32 tuya_strlen(const char* str) {
  68   1          u32 len = 0;
  69   1          if (str == NULL) {
  70   2              return 0;
  71   2          }
  72   1      
  73   1          for (len = 0; *str++ != '\0';) {
  74   2              len++;
  75   2          }
  76   1      
  77   1          return len;
  78   1      }
