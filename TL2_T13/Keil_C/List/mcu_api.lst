 149          char* tuya_strncpy(char* dest, const char* src, u16 count) {
 150   1          char* tmp = dest;
 151   1          while (count) {
 152   2              if ((*tmp = *src) != 0)
 153   2                  src++;
 154   2              tmp++;
 155   2              count--;
 156   2          }
 157   1          return dest;
 158   1      }
