 136          char* tuya_strcpy(char* dest, const char* src) {
 137   1          char* p = dest;
 138   1          if ((NULL == dest) || (NULL == src)) {
 139   2              return NULL;
 140   2          }
 141   1      
 142   1          while (*src != '\0') {
 143   2              *dest++ = *src++;
 144   2          }
 145   1          *dest = '\0';
 146   1          return p;
 147   1      }
