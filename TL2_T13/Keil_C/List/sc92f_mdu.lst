  60            
  61          /**
  62           * @brief  DeInitializes the mdu peripheral
  63           * @param  None         
  64           * @retval None
  65           */
  66          void MDU_DeInit(void)
  67          {
  68   1        OPERCON &= 0X3F;
  69   1        EXA0 = 0X00;
  70   1        EXA1 = 0X00;
  71   1        EXA2 = 0X00;
  72   1        EXA3 = 0X00;
  73   1        EXBL = 0X00;
  74   1        EXBH = 0X00;
  75   1      }
  76          
  77          /**
  78           * @brief  Configure MDU multiplication operation register.
  79           * @param  Multiplicand:  Multiplicand of MDU
  80           * @param  Multiplier:  Multiplier of MDU
  81           * @retval None
  82           */
  83          void MDU_MultiplicationConfig(uint16_t
  84                                        Multiplicand, uint16_t Multiplier)
  85          {
  86   1        OPERCON &= 0XBF;
  87   1        EXBL = Multiplier ;
  88   1        EXBH = Multiplier >> 8;
  89   1        EXA0 = Multiplicand ;
  90   1        EXA1 = Multiplicand >> 8;
  91   1      }
  92          
  93          /**
  94           * @brief  Configure MDU division operation register.
  95           * @param  Dividend:  Dividend of MDU.
  96           * @param  Divisor:  Divisor of MDU.
  97           * @retval None
  98           */
  99          void MDU_DivisionConfig(uint32_t Dividend,
 100                                  uint16_t Divisor)
 101          {
 102   1        MDU_Temp_Union MDU_DivisionTemp;
 103   1        MDU_DivisionTemp.MDU_Temp = Dividend;
 104   1        OPERCON |= 0X40;
 105   1        EXA0 = MDU_DivisionTemp.MDU_EXAxReg.MDU_EXA0Reg;
 106   1        EXA1 = MDU_DivisionTemp.MDU_EXAxReg.MDU_EXA1Reg;
 107   1        EXA2 = MDU_DivisionTemp.MDU_EXAxReg.MDU_EXA2Reg;
 108   1        EXA3 = MDU_DivisionTemp.MDU_EXAxReg.MDU_EXA3Reg;
C51 COMPILER V9.60.7.0   SC92F_MDU                                                         10/13/2026 10:46:32 PAGE 3   

 109   1        EXBL = Divisor;
 110   1        EXBH = Divisor >> 8;
 111   1      }
 112          
 113          /**
 114           * @brief  Initiate one MDU operation.
 115           * @param  None
 116           * @retval None
 117           */
 118          void MDU_StartOperation(void)
 119          {
 120   1        OPERCON |= 0x80;
 121   1      
 122   1        while(OPERCON & 0x80);
 123   1      }
 124          
 125          /**
 126           * @brief  Obtain the product after MDU operation.
 127           * @param  None
 128           * @retval MDU_Product: product value
 129           */
 130          uint32_t MDU_GetProduct(void)
 131          {
 132   1        MDU_Temp_Union MDU_ProductTemp;
 133   1        MDU_ProductTemp.MDU_EXAxReg.MDU_EXA0Reg = EXA0;
 134   1        MDU_ProductTemp.MDU_EXAxReg.MDU_EXA1Reg = EXA1;
 135   1        MDU_ProductTemp.MDU_EXAxReg.MDU_EXA2Reg = EXA2;
 136   1        MDU_ProductTemp.MDU_EXAxReg.MDU_EXA3Reg = EXA3;
 137   1        return MDU_ProductTemp.MDU_Temp;
 138   1      }
 139          
 140          /**
 141           * @brief  Obtain the quotient after MDU operation.
 142           * @param  None
 143           * @retval MDU_Quotient: Quotient value
 144           */
 145          uint32_t MDU_GetQuotient(void)
 146          {
 147   1        MDU_Temp_Union MDU_QuotientTemp;
 148   1        MDU_QuotientTemp.MDU_EXAxReg.MDU_EXA0Reg = EXA0;
 149   1        MDU_QuotientTemp.MDU_EXAxReg.MDU_EXA1Reg = EXA1;
 150   1        MDU_QuotientTemp.MDU_EXAxReg.MDU_EXA2Reg = EXA2;
 151   1        MDU_QuotientTemp.MDU_EXAxReg.MDU_EXA3Reg = EXA3;
 152   1        return MDU_QuotientTemp.MDU_Temp;
 153   1      }
 154          
 155          /**
 156           * @brief  Obtain the remainder after MDU operation.
 157           * @param  None
 158           * @retval MDU_Remainder: Remainde value.
 159           */
 160          uint16_t MDU_GetRemainder(void)
 161          {
 162   1        uint16_t MDU_RemainderTemp;
 163   1        MDU_RemainderTemp = EXBH * 256 + EXBL;
 164   1        return MDU_RemainderTemp;
 165   1      }
