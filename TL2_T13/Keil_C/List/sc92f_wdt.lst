  53           /**
C51 COMPILER V9.60.7.0   SC92F_WDT                                                         10/13/2026 10:46:36 PAGE 2   

  54           * @brief  The WDT-related register is reset to the default value
  55           * @param  None         
  56           * @retval None
  57           */
  58          void WDT_DeInit(void)
  59          {
  60   1        WDTCON = 0X00;
  61   1      }
  62          
  63          /**************************************************
  64          *函数名称:void WDT_Init(WDT_OverflowTime_TypeDef OverflowTime)
  65          *函数功能:WDT初始化配置函数
  66          *入口参数:
  67          WDT_OverflowTime_TypeDef:OverflowTime:WDT溢出时间选择
  68          *出口参数:void
  69          **************************************************/
  70           /**
  71           * @brief  WDT initialization configuration function
  72           * @param   OverflowTime:WDT overflow time selection
  73           *          - WDT_OverflowTime_500MS: Settings  500MS
  74           *          - WDT_OverflowTime_250MS: Settings 250MS
  75           *          - WDT_OverflowTime_125MS: Settings 125MS
  76           *          - WDT_OverflowTime_62_5MS:Settings 62.5MS
  77           *          - WDT_OverflowTime_31_5MS:Settings 31.5MS
  78           *          - WDT_OverflowTime_15_75MS:Settings 15.75MS
  79           *          - WDT_OverflowTime_7_88MS:Settings 7.88MS
  80           *          - WDT_OverflowTime_3_94MS:Settings 3.94MS
  81           * @retval None
  82           */
  83          void WDT_Init(WDT_OverflowTime_TypeDef
  84                        OverflowTime)
  85          {
  86   1        WDTCON = (WDTCON & 0XF8) | OverflowTime;
  87   1      }
  88          
  89          
  90          /**
  91           * @brief  WDT function switch function
  92           * @param  NewState[in]:Function Enable/disable selection   
  93           *              - DISABLE: disable    
  94           *              - ENABLE:Enable    
  95           * @retval None
  96           */
  97          void WDT_Cmd(FunctionalState NewState)
  98          {
  99   1        OPINX = 0XC1;
 100   1      
 101   1        if(NewState == DISABLE)
 102   1        {
 103   2          OPREG &= 0X7F;
 104   2        }
 105   1        else
 106   1        {
 107   2          OPREG |= 0X80;
 108   2        }
 109   1      }
 110          /**
 111           * @}
