 637           *          - TIM2_FLAG_TF2:中断标志位TF2，计数溢出
 638           *          - TIM2_FLAG_EXF2:中断标志位EXF2，外部触发
 639           * @retval TIMER2中断标志状态
 640           *                  - RESET:置零
 641           *                  - SET:置起
 642           */ 
 643          FlagStatus TIM2_GetFlagStatus(TIM2_Flag_TypeDef TIM2_Flag)
 644          {
 645   1        unsigned char TXINX_Stack = TXINX;
 646   1        FlagStatus status = RESET;
 647   1        TXINX = 0x02;
 648   1      
 649   1        if ((TIM2_Flag & TXCON) != (uint8_t)RESET)
 650   1        {
 651   2          status = SET;
 652   2        }
 653   1        else
 654   1        {
 655   2          status = RESET;
 656   2        }
 657   1        TXINX = TXINX_Stack;
 658   1        return status;
 659   1      }
 660          
 661          /**
 662           * @brief  清除TIMER2中断标志状态
 663           * @param  TIM2_Flag[in]:TIMER2标志选择
 664           *          - TIM2_FLAG_TF2:中断标志位TF2，计数溢出
 665           *          - TIM2_FLAG_EXF2:中断标志位EXF2，外部触发
C51 COMPILER V9.60.7.0   SC92F_TIMER2                                                      10/13/2026 10:46:34 PAGE 12  

 666           * @retval TIMER2中断标志状态
 667           *                  - RESET:置零
 668           *                  - SET:置起
 669           */
 670          void TIM2_ClearFlag(TIM2_Flag_TypeDef TIM2_Flag)
 671          {
 672   1        unsigned char TXINX_Stack = TXINX;
 673   1        TXINX = 0x02;
 674   1        TXCON &= (~TIM2_Flag);
 675   1        TXINX = TXINX_Stack;
 676   1      }
