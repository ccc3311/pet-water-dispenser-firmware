               *          - Status_TIMEOUT:³¬Ê±
               */
              StatusTypeDef SSI_UART_Receive(SSI_HandleInfoDef* SSI_HANDLE, uint8_t* pData, uint8_t Size, uint32_t Timeo
             -ut)
              {
                uint32_t delaytime = 0;
                /* ¼ì²é½ÓÊÕ½ø³ÌÕýÔÚÔËÐÐ */
                if(SSI_HANDLE->RxState == SSI_STATE_READY)
                {
                  /* ¼ì²é½ÓÊÕÊý¾ÝÁ¿´óÐ¡ºÍÊÇ·ñ¿ªÆô½ÓÊÕÊ¹ÄÜ */
                  if((IE1 & 0x01 != 0) || (Size == 0U) || ((SSCON0 & 0x10) != UART1_RX_ENABLE))
                  {
                    return  Status_ERROR;
                  }
              
                  SSI_HANDLE->RxState = SSI_STATE_BUSY;     //½ÓÊÕ½ø³ÌÃ¦ÂµÖÐ
                  SSI_ClearFlag(UART1_FLAG_RI);      //½ÓÊÕÇ°Çå³ý½ÓÊÕÖÐ¶Ï±êÖ¾
                  SSI_HANDLE->pRxBuffPtr.Size_u8 = pData;     //Ö¸Ïò´ý½ÓÊÕÊý¾ÝµÄµØÖ·
                  SSI_HANDLE->RxXferSize = Size;      //¸üÐÂ´ý½ÓÊÕµÄÊý¾ÝÁ¿
                  SSI_HANDLE->RxXferCount = 0;      //½ÓÊÕ¼ÆÊýÆ÷ÇåÁã
              
                  while(SSI_HANDLE->RxXferCount < SSI_HANDLE->RxXferSize) //ÅÐ¶ÏÊÇ·ñ½ÓÊÕËùÓÐÊý¾Ý
                  {
                    if(SSI_GetFlagStatus(UART1_FLAG_RI)) //ÅÐ¶Ï½ÓÊÕ±êÖ¾Î»
                    {
                      SSI_ClearFlag(UART1_FLAG_RI);     //½ÓÊÕ±êÖ¾Î»ÇåÁã
              
                      /* ´ý½ÓÊÕÊý¾ÝÁ¿Î´Îª0£¬¼ÌÐø·¢ËÍ */
                      if((SSCON0 & 0x80) == UART1_Mode_11B)
                      {
                        /* ½ÓÊÕ9Î»Êý¾Ý */
                        *(SSI_HANDLE->pRxBuffPtr.Size_u16 + SSI_HANDLE->RxXferCount) = SSI_UART1_ReceiveData9();
                      }
                      else
C51 COMPILER V9.60.7.0   SC92F_SSI                                                         10/13/2026 10:46:33 PAGE 25  

                      {
                        /* ½ÓÊÕ8Î»Êý¾Ý */
                        *(SSI_HANDLE->pRxBuffPtr.Size_u8 + SSI_HANDLE->RxXferCount) = SSI_UART1_ReceiveData8();
                      }
              
                      SSI_HANDLE->RxXferCount++;  //½ÓÊÕÊý¾ÝÁ¿¼ÆÊý
                      delaytime = 0;//ÊÕµ½Êý¾Ý£¬³¬Ê±¼ÆÊýÇåÁã
                    }
                    if(delaytime++ > Timeout)//¼ÆÊ±Òç³ö
                    {
                      SSI_HANDLE->RxState = SSI_STATE_TIMEOUT;//½ÓÊÕ³¬Ê±
                      return Status_TIMEOUT;
                    }
                  }
              
                  if(SSI_HANDLE->RxXferCount == SSI_HANDLE->RxXferSize)
                  {
                    SSI_HANDLE->RxState = SSI_STATE_READY;  //½ÓÊÕÍê³É
                    return Status_OK;
                  }
                  else
                  {
                    SSI_HANDLE->RxState = SSI_STATE_ERROR;//·¢Éú½ÓÊÕ´íÎó
                    return Status_ERROR;
                  }
                }
                else
                {
                  return Status_BUSY;//·µ»Ø±êÖ¾Î»
                }
              }
              
