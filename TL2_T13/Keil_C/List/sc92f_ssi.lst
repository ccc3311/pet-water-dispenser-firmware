C51 COMPILER V9.60.7.0   SC92F_SSI                                                         10/13/2026 10:46:33 PAGE 27  

               *              - LOW:µÍ
               *              - HIGH:¸ß
               * @retval None
               */ 
              void SSI_ITConfig(FunctionalState NewState,
                                PriorityStatus Priority)
              {
                if(NewState != DISABLE)
                {
                  IE1 |= 0x01;
                }
                else
                {
                  IE1 &= 0xFE;
                }
              
                /************************************************************/
                if(Priority != LOW)
                {
                  IP1 |= 0x01;
                }
                else
                {
                  IP1 &= 0xFE;
                }
              }
              
