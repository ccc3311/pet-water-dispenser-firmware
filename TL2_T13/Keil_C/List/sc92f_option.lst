 189           * SC92R436,SC92R438,SC92R439,SC92R422A,SC92F652x,SC92F5x5x,SC92F531x,SC92F663x Selection Range
 190           *            - ADC_VREF_VDD: ADC reference voltage is VDD 
 191           *            - ADC_VREF_1_024V: ADC reference voltage is 1.024V
 192           *            - ADC_VREF_2_4V: ADC reference voltage is 2.4V
 193           *            - ADC_VREF_2_048V: ADC reference voltage is 2.048V
 194           * SC92L840x Selection Range
 195           *            - ADC_VREF_VDD: ADC reference voltage is VDD 
 196           *            - ADC_VREF_1_024V: ADC reference voltage is 2.4V
 197           * @retval None
 198           */
 199          #if !defined(SC92F637x)
 200          void OPTION_ADC_VrefConfig(ADC_Vref_TypeDef
 201                                     ADC_Vref)
 202          {
 203   1        OPINX = 0xC2;
 204   1        #if defined (SC92F859x) || defined (SC92F759x) || defined (SC92F848x) || defined (SC92F748x) || defined (
             -SC92L853x) || defined (SC92L753x)\
 205   1          || defined (SC92R511x) || defined(SC92F646x) || defined(SC92F546x) || defined(SC92F542x) || defined(SC92
             -F6x1x) || defined(SC92F5x1x)|| defined(SC92R436)\
 206   1          || defined(SC92R438)|| defined(SC92R439)|| defined(SC92R422A)|| defined(SC92F652x)|| defined(SC92R51x_R
             -52x) || defined (SC92F552x)|| defined(SC92F5x5x)\
 207   1          || defined(SC92F531x) || defined(SC92F663x)
 208   1        {
 209   2          OPREG = OPREG & 0X3F | ADC_Vref;
 210   2        }
 211   1        #else
                {
                OPREG = OPREG & 0X7F | ADC_Vref;
                }
                #endif
 216   1      }
