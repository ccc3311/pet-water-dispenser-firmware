  55            /**
  56            * @brief  Enables or disables the WDT peripheral.
  57            * @param  NewState[in]:  new state of the WDT peripheral.
  58            *                  - DISABLE:Function disable
  59            *                  - ENABLE:Function enable 
  60            * @retval None
  61            */
  62          void OPTION_WDT_Cmd(FunctionalState NewState)
  63          {
  64   1        OPINX = 0XC1;
  65   1      
  66   1        if(NewState == DISABLE)
  67   1        {
  68   2          OPREG &= 0X7F;
  69   2        }
  70   1        else
  71   1        {
  72   2          OPREG |= 0X80;
  73   2        } 
  74   1      }
  75          
  76          /**
  77            * @brief  Enables or disables the XTIPLL clock.
  78            * @param  NewState[in]: new state of the XTIPLL clock. 
  79            *                   - DISABLE:Function disable
  80            *                   - ENABLE:Function enable   
  81            * @retval None
  82            */
  83          #if !defined(SC92F848x) && !defined(SC92F748x) && !defined(SC92F730x_2) && !defined(SC92F720x) && !defined
             -(SC92F5x5x) && !defined(SC92F531x)\
  84              && !defined(SC92F637x) && !defined(SC92F663x)
  85          void OPTION_XTIPLL_Cmd(FunctionalState NewState)
  86          {
  87   1        OPINX = 0XC1;
  88   1      
  89   1        if(NewState == DISABLE)
  90   1        {
  91   2          OPREG &= 0XBF;
  92   2        }
  93   1        else
  94   1        {
  95   2          OPREG |= 0X40;
  96   2        }
  97   1      }
  98          #endif
  99          /**
 100            * @brief  System clock frequency initialization.
 101            * @param  SYSCLK_PresSel[in]: specifies the SYSCLK crossover frequencies. 
 102            *                   - SYSCLK_PRESSEL_FOSC_D1:SYSCLK clock = SYSCLK/1
 103            *                   - SYSCLK_PRESSEL_FOSC_D2:SYSCLK clock = SYSCLK/2 
 104            *                   - SYSCLK_PRESSEL_FOSC_D4:SYSCLK clock = SYSCLK/4
 105            *                   - SYSCLK_PRESSEL_FOSC_D12:SYSCLK clock = SYSCLK/12
 106            *  SC92L853x,SC92L753x SYSCLK crossover frequencies selection range
 107            *                   - SYSCLK_PRESSEL_FOSC_D1:SYSCLK clock = SYSCLK/1
 108            *                   - SYSCLK_PRESSEL_FOSC_D2:SYSCLK clock = SYSCLK/2 
 109            *                   - SYSCLK_PRESSEL_FOSC_D4:SYSCLK clock = SYSCLK/4
 110            *                   - SYSCLK_PRESSEL_FOSC_D8:SYSCLK clock = SYSCLK/8
 111            *  SC92R436,SC92R438,SC92R439,SC92L840x,SC92R422A SYSCLK crossover frequencies selection range
 112            *                   - SYSCLK_PRESSEL_FOSC_D2:SYSCLK clock = SYSCLK/2 
 113            *                   - SYSCLK_PRESSEL_FOSC_D4:SYSCLK clock = SYSCLK/4
 114            *                   - SYSCLK_PRESSEL_FOSC_D12:SYSCLK clock = SYSCLK/12
C51 COMPILER V9.60.7.0   SC92F_OPTION                                                      10/13/2026 10:46:29 PAGE 3   

 115            * @retval None
 116            */
 117          void OPTION_SYSCLK_Init(SYSCLK_PresSel_TypeDef
 118                                  SYSCLK_PresSel)
 119          {
 120   1        OPINX = 0XC1;
 121   1        OPREG = OPREG & 0XCF | SYSCLK_PresSel;
 122   1      }
