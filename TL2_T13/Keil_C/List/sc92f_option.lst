 124          /**
 125            * @brief  Enables or disables the RST Pin.
 126            * @param  NewState[in]:  new state of the RST Pin.
 127            *                  - DISABLE:Function disable
 128            *                  - ENABLE:Function enable 
 129            * @retval None
 130            */
 131          #if !defined(SC92F848x) && !defined(SC92F748x)  && !defined(SC92F859x) && !defined (SC92F759x)  && !define
             -d(SC92L853x) && !defined (SC92L753x)\
 132              && !defined (SC92R511x) && !defined (SC92L840x)
              void OPTION_RST_PIN_Cmd(FunctionalState NewState)
              {
                OPINX = 0XC1;
              
                if(NewState == DISABLE)
                {
                  OPREG |= 0X08;
                }
                else
                {
                  OPREG &= 0XF7;
                }
              }
              #endif
