 823          void ADC_Cmd(FunctionalState NewState)
 824          {
 825   1        if (NewState == DISABLE)
 826   1        {
 827   2          /* Disable the ADC Counter */
 828   2        ADCCON &= 0X7F;
 829   2        }
 830   1        else
 831   1        {
 832   2          /* Enable the ADC Counter */
 833   2        ADCCON |= 0x80;
 834   2        }
 835   1      }
