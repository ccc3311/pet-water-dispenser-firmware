 870          uint16_t ADC_GetConversionAverageValue(ADC_SamplesNum_TypeDef ADC_SamplesNum)
 871          {
 872   1        uint8_t tmpCnt;
 873   1        uint16_t tmpValueSum = 0, tmpValue;
 874   1        uint16_t tmpValue_Max = 0, tmpValue_Min = 0xFFFF;
 875   1        bit tmpStaus = EADC;
 876   1        EADC = 0;
 877   1      
 878   1        for (tmpCnt = 0; tmpCnt < ADC_SamplesNum; tmpCnt++)
 879   1        {
 880   2          ADC_StartConversion();      //Start an ADC conversion.
 881   2          while (!ADC_GetFlagStatus());     //Waiting for ADC conversion to complete.
 882   2          ADC_ClearFlag();      //Clear ADC conversion flag.
 883   2          tmpValue = ADC_GetConversionValue();      //Obtain a single conversion value.
 884   2      
 885   2          /*Get the maximum value among multiple conversion values */
 886   2          if (tmpValue > tmpValue_Max)
 887   2            tmpValue_Max = tmpValue;
 888   2          /* Get the minimum value among multiple conversion results */
 889   2          if (tmpValue < tmpValue_Min)
 890   2            tmpValue_Min = tmpValue;
 891   2      
 892   2          tmpValueSum += tmpValue;//The sum of accumulated conversion values
 893   2        }
 894   1      
 895   1        /* Calculate the average using hardware multiplier/divider */
 896   1        {
 897   2          OPERCON |= 0X40;
 898   2          /* Dividend is a 16-bit data */
 899   2          tmpValueSum -= (tmpValue_Max + tmpValue_Min);
 900   2          EXA0 = tmpValueSum;
 901   2          EXA1 = tmpValueSum >> 8;
 902   2          EXBL = ADC_SamplesNum - 2;      //The divisor is an 8-bit data.
 903   2      
 904   2          OPERCON |= 0x80;        //Start division calculation.
 905   2          while (OPERCON & 0x80);     //Waiting for computation to complete.
 906   2      
 907   2          //Acquisition Factor
 908   2          tmpValue = (uint16_t)EXA0;
 909   2          tmpValue |= EXA1 << 8;
 910   2        }
 911   1      
 912   1        EADC = tmpStaus;      //Restore EADC
 913   1        return tmpValue;      //return the average
 914   1      }
 915          
 916          #else
              uint16_t ADC_GetConversionAverageValue(ADC_SamplesNum_TypeDef ADC_SamplesNum)
              {
                uint8_t tmpCnt;
                uint16_t tmpValueSum = 0, tmpValue;
                uint16_t tmpValue_Max = 0, tmpValue_Min = 0xFFFF;
                bit tmpStaus = EADC;
                EADC = 0;
              
                for (tmpCnt = 0; tmpCnt < ADC_SamplesNum; tmpCnt++)
                {
                  ADC_StartConversion();      //Start an ADC conversion.
                  while (!ADC_GetFlagStatus());     //Waiting for ADC conversion to complete.
                  ADC_ClearFlag();      //Clear ADC conversion flag.
                  tmpValue = ADC_GetConversionValue();      //Obtain a single conversion value.
C51 COMPILER V9.60.7.0   SC92F_ADC                                                         10/13/2026 10:46:30 PAGE 17  

              
                  /*Get the maximum value among multiple conversion values */
                  if (tmpValue > tmpValue_Max)
                    tmpValue_Max = tmpValue;
                  /* Get the minimum value among multiple conversion results */
                  if (tmpValue < tmpValue_Min)
                    tmpValue_Min = tmpValue;
              
                  tmpValueSum += tmpValue;//The sum of accumulated conversion values
                }
              
                /* Calculate the average using software multiplication and division */
                {
                  /* Dividend is a 16-bit data */
                  tmpValueSum -= (tmpValue_Max + tmpValue_Min);
              
                  //Acquisition Factor
                  tmpValue = tmpValueSum / (ADC_SamplesNum - 2);
                }
              
                EADC = tmpStaus;      //Restore EADC
                return tmpValue;      //return the average
              }
              #endif
