  55          /**
  56           * @brief  LPD相关寄存器复位至缺省值
  57           * @param  None
  58           * @retval None
  59           */ 
  60          void LPD_DeInit(void)
  61          {
  62   1        /* 配置相关寄存器复位 */
  63   1        LPDCFG = 0x00;
  64   1        /* 中断相关寄存器复位 */
  65   1        IE2 &= 0x7F;
  66   1        IP2 &= 0x7F;
  67   1      }
  68          
  69          /**
  70           * @brief  设置LPD门限电压阈值
  71           * @param  LPD_Vtrip[in]: LPD门限电压阈值
  72           *              - LPD_VTRIP_1_85V:LPD门限电压阈值为1.85V
  73           *              - LPD_VTRIP_2_05V:LPD门限电压阈值为2.05V
  74           *              - LPD_VTRIP_2_25V:LPD门限电压阈值为2.25V
  75           *              - LPD_VTRIP_2_45V:LPD门限电压阈值为2.45V
  76           *              - LPD_VTRIP_2_65V:LPD门限电压阈值为2.65V
  77           *              - LPD_VTRIP_2_85V:LPD门限电压阈值为2.85V
  78           *              - LPD_VTRIP_3_45V:LPD门限电压阈值为3.05V
  79           *              - LPD_VTRIP_3_45V:LPD门限电压阈值为3.45V
  80           *              - LPD_VTRIP_3_85V:LPD门限电压阈值为3.85V
  81           *              - LPD_VTRIP_4_45V:LPD门限电压阈值为4.45V
  82           * @retval None
  83           */ 
  84          void LPD_VtripConfig(LPD_Vtrip_TypeDef LPD_Vtrip)
  85          {
  86   1        LPDCFG &= 0xF1; /*复位门限电压阈值寄存器*/
  87   1        LPDCFG = LPD_Vtrip << 1;  /*设置门限电压阈值寄存器*/
  88   1      }
  89          
  90          /**
  91           * @brief  使能LPD功能
  92           * @param  NewState[in]: 断使能/关闭选择
  93           *              - DISABLE:关闭
  94           *              - ENABLE:使能
  95           * @retval None
  96           */ 
  97          void LPD_Cmd(FunctionalState NewState)
  98          {
  99   1        if(NewState == ENABLE)
 100   1        {
 101   2          LPDCFG |= 0x01;
 102   2          
 103   2        }
 104   1        else
 105   1        {
 106   2          LPDCFG &= 0xFE;
 107   2        }
 108   1      }
 109          /**
 110           * @}
 111           */
 112          /* End of LPD_Group1. */
