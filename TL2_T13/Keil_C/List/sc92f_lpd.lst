 126          /**
 127           * @brief  LPD中断初始化
 128           * @param  NewState[in]: 断使能/关闭选择
 129           *              - DISABLE:关闭
 130           *              - ENABLE:使能
 131           * @param  Priority[in]: 中断优先级选择
 132           *              - LOW:低
 133           *              - HIGH:高
 134           * @retval None
 135           */ 
 136          void LPD_ITConfig(FunctionalState NewState, PriorityStatus Priority)
 137          {
 138   1      
 139   1        /* 中断开关 */
 140   1        if (NewState != DISABLE)
 141   1        {
 142   2          IE2 |= 0x80;
 143   2        }
 144   1        else
 145   1        {
 146   2          IE2 &= 0x7F;
 147   2        }
 148   1      
 149   1      
 150   1        /* 中断开关 */
 151   1        if (Priority != LOW)
 152   1        {
 153   2          IP2 |= 0x80;
 154   2        }
 155   1        else
 156   1        {
 157   2          IP2 &= 0x7F;
 158   2        }
 159   1      
 160   1      }
 161          
 162          /**
 163           * @}
 164           */
 165          /* End of LPD_Group2. */
