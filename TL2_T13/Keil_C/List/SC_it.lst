 204          void USCI2Interrupt(void) interrupt 16
 205          {
 206   1          unsigned char status;
 207   1          unsigned char rx_data = 0;
 208   1      
 209   1          /* 保存本次待处理标志。 */
 210   1          status = US2CON0;
 211   1      
 212   1          if (status & 0x01) {
 213   2              rx_data = USCI2_UART_ReceiveData8();
 214   2          }
 215   1      
 216   1          /*
 217   1           * TI、RI 写 1 清零。
 218   1           * 只清本次快照中的标志，保留其他控制位。
 219   1           */
 220   1          US2CON0 = (US2CON0 & 0xFC) | (status & 0x03);
 221   1      
 222   1          if (status & 0x02) {
 223   2              g_usci2_tx_done = 1;
 224   2          }
 225   1      
 226   1          if (status & 0x01) {
C51 COMPILER V9.60.7.0   SC_IT                                                             10/13/2026 16:43:52 PAGE 5   

 227   2              uart_receive_input(rx_data);
 228   2          }
 229   1      }
