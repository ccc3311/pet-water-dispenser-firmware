 592   2            else
 593   2            {
 594   3              bitstatus = RESET;
 595   3            }
 596   2          }
 597   1          else
 598   1          {
 599   2            if ((USCI2_FLAG & US2CON0) != (uint8_t)RESET)
 600   2            {
 601   3              bitstatus = SET;
 602   3            }
 603   2            else
