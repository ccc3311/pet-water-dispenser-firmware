 440          /**
 441           * @brief  UART初始化配置函数
 442           * @param  UARTFsys[in]:系统时钟频率
 443           * @param  BaudRate[in]:波特率
 444           * @param  Mode[in]:UART0工作模式
 445           *          - USCI2_UART_Mode_8B:UART设置为8位模式
 446           *          - USCI2_UART_Mode_10B:UART设置为10位模式
 447           *          - USCI2_UART_Mode_11B:UART设置为11位模式
 448           * @param  RxMode[in]:接收允许选择
 449           *          - USCI2_UART_RX_ENABLE:UART允许接收
 450           *          - USCI2_UART_RX_DISABLE:UART禁止接收
 451           * @retval None
 452           */
 453          void USCI2_UART_Init(uint32_t UARTFsys, uint32_t BaudRate, USCI2_UART_Mode_TypeDef Mode,
 454                               USCI2_UART_RX_TypeDef RxMode)
 455          {
 456   1        TMCON |= 0xC0;
 457   1        US2CON0 = US2CON0 & 0X0F | Mode | RxMode;
 458   1      
 459   1        if (Mode == USCI2_UART_Mode_8B)
 460   1        {
 461   2          if (BaudRate == USCI2_UART_BaudRate_FsysDIV12)
 462   2          {
 463   3            US2CON0 &= 0XDF;
 464   3          }
 465   2          else if (BaudRate == USCI2_UART_BaudRate_FsysDIV4)
 466   2          {
 467   3            US2CON0 |= 0X20;
 468   3          }
 469   2        }
 470   1        else
 471   1        {
 472   2          US2CON2 = UARTFsys / BaudRate / 256;
 473   2          US2CON1 = UARTFsys / BaudRate % 256;
 474   2        }
 475   1      }
