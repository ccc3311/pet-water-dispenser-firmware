  87          /**
  88           * @brief  模拟 I2C 读取一个字节
  89           * @return 读到的 8 bit 数据
  90           */
  91          static uint8_t I2C_ReadByte(void) {
  92   1          uint8_t i;
  93   1          uint8_t dat = 0;
  94   1      
  95   1          // 重点：单片机准备读取数据前，必须释放 SDA 总线
  96   1          // (在准双向口/开漏模式下，写 1 代表释放总线，配置为输入)
  97   1          TM_SDA = 1; 
  98   1          I2C_Delay();
  99   1      
 100   1          for (i = 0; i < 8; i++) {
 101   2              dat <<= 1;
 102   2              
 103   2              TM_SCL = 1; // 时钟拉高，此时 TM1650 会把数据放到 SDA 上
 104   2              I2C_Delay();
 105   2              
 106   2              // 采样 SDA 数据
 107   2              if (TM_SDA) {
 108   3                  dat |= 0x01;
 109   3              }
 110   2              
 111   2              TM_SCL = 0; // 时钟拉低，通知 TM1650 准备下一位
 112   2              I2C_Delay();
 113   2          }
 114   1      
 115   1          // 处理第 9 个时钟 (ACK 时钟位)
C51 COMPILER V9.60.7.0   HAL_TM1650                                                        10/13/2026 10:46:38 PAGE 3   

 116   1          // 根据 TM1650 数据手册图5，读数据时无需主机应答，只需给足时钟信号即可释放
 117   1          TM_SDA = 1; 
 118   1          I2C_Delay();
 119   1          TM_SCL = 1;
 120   1          I2C_Delay();
 121   1          TM_SCL = 0;
 122   1      
 123   1          return dat;
 124   1      }
