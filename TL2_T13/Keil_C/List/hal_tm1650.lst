   6          #define TM_SCL  P04
   7          #define TM_SDA  P05
   8          
   9          // --- TM1650 寄存器地址定义 ---
  10          #define TM1650_CMD_SYS   0x48  // 系统控制命令 (显存操作)
  11          #define TM1650_DIG1      0x68  // 显存地址1
  12          #define TM1650_DIG2      0x6A  // 显存地址2
  13          #define TM1650_DIG3      0x6C  // 显存地址3
  14          #define TM1650_DIG4      0x6E  // 显存地址4
  15          
  16          // --- 显存缓存区 ---
  17          // 因为 TM1650 不支持单独修改某个位(只能整字节写入)，
  18          // 我们需要在 RAM 里建一个显存缓存，修改缓存后再把整字节刷进去。
  19          static uint8_t TM1650_Buffer[4] = {0, 0, 0, 0};
  20          
  21          static void I2C_Delay(void) {
  22   1          // ！！！核心：加上 volatile 关键字 ！！！
  23   1          // 这会警告编译器：“绝对不许优化这段代码，必须老老实实执行”
  24   1          volatile uint8_t i = 15; 
  25   1      //    while(i--);
  26   1      }
  27          static void I2C_Start(void) {
  28   1          TM_SDA = 1;
  29   1          TM_SCL = 1;
  30   1          I2C_Delay();
  31   1          TM_SDA = 0; // SCL高期间，SDA拉低产生起始信号
  32   1          I2C_Delay();
  33   1          TM_SCL = 0;
  34   1          I2C_Delay();
  35   1      }
  36          
  37          static void I2C_Stop(void) {
  38   1          TM_SCL = 0; 
  39   1          TM_SDA = 0; // 确保SDA在SCL拉高前是低电平
  40   1          I2C_Delay();
  41   1          TM_SCL = 1;
  42   1          I2C_Delay();
  43   1          TM_SDA = 1; // SCL高电平时，SDA拉高产生停止信号
  44   1          I2C_Delay();
  45   1      }
  46          
  47          static void I2C_WriteByte(uint8_t dat) {
  48   1          uint8_t i;
  49   1          for (i = 0; i < 8; i++) {
  50   2              TM_SCL = 0; // 先拉低时钟，允许数据变化
  51   2              I2C_Delay();
  52   2              
  53   2              if (dat & 0x80) {
C51 COMPILER V9.60.7.0   HAL_TM1650                                                        10/13/2026 10:46:38 PAGE 2   

  54   3                  TM_SDA = 1;
  55   3              } else {
  56   3                  TM_SDA = 0;
  57   3              }
  58   2              I2C_Delay(); // 等待数据稳定
  59   2              
  60   2              TM_SCL = 1; // 拉高时钟，让 TM1650 采样
  61   2              I2C_Delay(); 
  62   2              
  63   2              dat <<= 1;
  64   2          }
  65   1          
  66   1          // --- 极其关键的第 9 个时钟 (处理 ACK) ---
  67   1          TM_SCL = 0; // 拉低时钟，准备接收 ACK
  68   1          TM_SDA = 1; // ！！！MCU必须释放总线(写1)，允许 TM1650 拉低总线 ！！！
  69   1          I2C_Delay();
  70   1          
  71   1          TM_SCL = 1; // 产生第 9 个时钟，TM1650 此时应该拉低了 SDA
  72   1          I2C_Delay(); 
  73   1          
  74   1          TM_SCL = 0; // 结束第 9 个时钟
  75   1          I2C_Delay();
  76   1      }
  77          
  78          // 写入一个指令到 TM1650
  79          static void TM1650_WriteCmd(uint8_t addr, uint8_t dat) {
  80   1          I2C_Start();
  81   1          I2C_WriteByte(addr);
  82   1          I2C_WriteByte(dat);
  83   1          I2C_Stop();
  84   1      }
