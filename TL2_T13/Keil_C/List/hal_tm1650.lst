 168          /**
 169           * @brief  控制单颗 LED 的亮灭 (支持分级映射与逻辑反转)
 170           * @param  led_id: 灯光枚举 ID
 171           * @param  status: LED_ON 或 LED_OFF
 172           */
 173          void HAL_LED_SetStatus(LedId_t led_id, uint8_t status) {
 174   1          uint8_t addr_index = 0;  // 对应 DIG1~DIG4 (0~3)
 175   1          uint8_t bit_mask = 0;    // 对应 SEG 的哪一位
 176   1          uint8_t is_inverted = 0; // 标记是否为“相反触发”
 177   1          uint8_t final_status = status; // 处理 "相反触发" 的防弹逻辑
C51 COMPILER V9.60.7.0   HAL_TM1650                                                        10/13/2026 10:46:38 PAGE 4   

 178   1      
 179   1          // ==========================================
 180   1          // 硬件走线严格映射区 (基于原理图 image_403ca0.png)
 181   1          // ==========================================
 182   1          switch (led_id) {
 183   2              // --- DIG2: 状态指示灯 (正向逻辑: 写1亮，写0灭) ---    
 184   2            //===============修改1：指示灯逻辑==================================
 185   2              case LED_NO_WATER:        addr_index = 1; bit_mask = (1 << 1); break; // B1
 186   2              case LED_WATER_Q:         addr_index = 1; bit_mask = (1 << 2); break; // C1
 187   2              case LED_HEATING:         addr_index = 1; bit_mask = (1 << 3); break; // D1
 188   2              case LED_MODE_CONT:       addr_index = 1; bit_mask = (1 << 4); break; // E1
 189   2              case LED_MODE_SENSE:      addr_index = 1; bit_mask = (1 << 5); break; // F1
 190   2              case LED_SW2:             addr_index = 1; bit_mask = (1 << 6); break; // G1
 191   2              case LED_SW1:             addr_index = 1; bit_mask = (1 << 7); break; // DP1
 192   2      
 193   2              // --- DIG3: 感应指示灯组 (相反触发: 软件自动翻转) ---
 194   2              case LED_SENSE_IND_1:     addr_index = 2; bit_mask = (1 << 2); break; // C1
 195   2              case LED_SENSE_IND_2:     addr_index = 2; bit_mask = (1 << 3); break; // D1
 196   2              case LED_SENSE_IND_3:     addr_index = 2; bit_mask = (1 << 4); break; // E1
 197   2              case LED_SENSE_IND_4:     addr_index = 2; bit_mask = (1 << 5); break; // F1
 198   2              case LED_SENSE_IND_5:     addr_index = 2; bit_mask = (1 << 6); break; // G1
 199   2      
 200   2              default: return; // 非法 ID 保护
 201   2          }
 202   1      
 203   1          // ==========================================
 204   1          // 修改显存缓存 (Read-Modify-Write)
 205   1          // ==========================================
 206   1          if (final_status == LED_ON) {
 207   2              TM1650_Buffer[addr_index] |= bit_mask;  // 置 1
 208   2          } else {
 209   2              TM1650_Buffer[addr_index] &= ~bit_mask; // 清 0
 210   2          }
 211   1          
 212   1          // ==========================================
 213   1          // 局部刷新：将更新后的单字节推送到芯片，拒绝全局刷屏
 214   1          // ==========================================
 215   1          /* DIG地址每组递增2，直接计算地址，合并四个刷新分支。 */
 216   1          TM1650_WriteCmd(
 217   1              (uint8_t)(TM1650_DIG1 + (addr_index << 1)),
 218   1              TM1650_Buffer[addr_index]);
 219   1      }
