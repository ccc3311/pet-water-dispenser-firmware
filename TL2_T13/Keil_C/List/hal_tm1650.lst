 222          /**
 223           * @brief  将所有 DIG 的 DP 设置为高电平
 224           * @note   注意：物理引脚输出的仍是带有消隐间隔的脉冲波，并非纯直流高电平
 225           */
 226          void HAL_LED_SetAllSegaHigh1(void) {
 227   1          uint8_t i;
 228   1      //    uint8_t sega_mask = 0x80; // DP 
 229   1              uint8_t sega_mask = 0xff; // ALL 
 230   1      
 231   1          for(i = 0; i < 4; i++) {
 232   2              TM1650_Buffer[i] |= sega_mask; // 置 1
 233   2          }
 234   1          
 235   1          // 2. 将修改后的 4 个字节全部刷新到 TM1650
 236   1          TM1650_WriteCmd(TM1650_DIG1, TM1650_Buffer[0]);
 237   1          TM1650_WriteCmd(TM1650_DIG2, TM1650_Buffer[1]);
 238   1          TM1650_WriteCmd(TM1650_DIG3, TM1650_Buffer[2]);
 239   1          TM1650_WriteCmd(TM1650_DIG4, TM1650_Buffer[3]);
