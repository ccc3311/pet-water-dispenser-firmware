 126          /**
 127           * @brief  读取 TM1650 当前的按键状态
 128           * @return 8位键值。如果没有按键按下，通常返回 0x00 (或其它非按下的释放码)
 129           */
 130          uint8_t HAL_TM1650_ReadKey(void) {
 131   1          uint8_t keycode = 0;
 132   1          
 133   1          I2C_Start();
 134   1          I2C_WriteByte(0x4F);     // 发送读取按键的命令 0x4F
 135   1          keycode = I2C_ReadByte(); // 读取 1 个字节的键值
 136   1          I2C_Stop();
 137   1          
 138   1          return keycode;
 139   1      }
