 155          /**
 156           * @brief  清空所有指示灯
 157           */
 158          void HAL_LED_ClearAll(void) {
 159   1          uint8_t i;
 160   1          for(i=0; i<4; i++) TM1650_Buffer[i] = 0;
 161   1          
 162   1          TM1650_WriteCmd(TM1650_DIG1, 0x00);
 163   1          TM1650_WriteCmd(TM1650_DIG2, 0x00);
 164   1          TM1650_WriteCmd(TM1650_DIG3, 0x00);
 165   1          TM1650_WriteCmd(TM1650_DIG4, 0x00);
 166   1      }
