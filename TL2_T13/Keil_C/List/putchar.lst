              char putchar(char c)
              {
                 uint16_t i = 0;
                 Printf_SendData8(c);
                 while(!Printf_GetTxStatus)
                 {
                   
                   
                    if(20000<i++)
                    {
                      break;
                    }
                 }
                 
                 Printf_ClearTxFlag;
                 return c;
              }
              #endif
