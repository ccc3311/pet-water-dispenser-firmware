 350           * @param  DDIC_Control_Status[in]: The status of the control bit corresponding to DDIC.
 351           *                     - DDIC_Control_ON:Enable.
 352           *                     - DDIC_Control_OFF:Disable.
 353           * @retval None
 354           */
 355          #if defined(SC92F652x)|| defined(SC92R51x_R52x) || defined (SC92F552x)
              void DDIC_Control(DDIC_Control_SEG_TypeDef DDIC_Seg,
                                uint8_t DDIC_Com,
                                DDIC_Control_Status DDIC_Contr)
              {
                if(DDIC_Contr)
                {
                  if(DDIC_Seg < 0x0100)
                  {
                    LED_LCDRAM[DDIC_Com*2] |= (uint8_t)DDIC_Seg;
                  }
                  else if(DDIC_Seg < 0x010000)
                  {
                    LED_LCDRAM[DDIC_Com*2+1] |= (uint8_t)(DDIC_Seg>>8);
                  }
                }
                else
                {
                  if(DDIC_Seg < 0x0100)
                  {
                    LED_LCDRAM[DDIC_Com*2] &= ~(uint8_t)DDIC_Seg;
                  }
                  else if(DDIC_Seg < 0x010000)
                  {
                    LED_LCDRAM[DDIC_Com*2+1] &= ~(uint8_t)(DDIC_Seg>>8);
                  }
                }
              }
              #elif defined(SC92F663x)
              void DDIC_Control(DDIC_Control_SEG_TypeDef DDIC_Seg,
                                uint8_t DDIC_Com,
                                DDIC_Control_Status DDIC_Contr)
              {
                if(DDIC_Contr)
                {
                  if(DDIC_Seg < 0x0100)
                  {
                    LEDRAM[DDIC_Com*2+1] |= (uint8_t)DDIC_Seg;
                  }
                  else if(DDIC_Seg < 0x010000)
                  {
                    LEDRAM[DDIC_Com*2] |= (uint8_t)(DDIC_Seg>>8);
                  }
                }
                else
                {
                  if(DDIC_Seg < 0x0100)
                  {
                    LEDRAM[DDIC_Com*2+1] &= ~(uint8_t)DDIC_Seg;
                  }
                  else if(DDIC_Seg < 0x010000)
                  {
                    LEDRAM[DDIC_Com*2] &= ~(uint8_t)(DDIC_Seg>>8);
                  }
                }
              }
              #elif defined(SC92F531x)
C51 COMPILER V9.60.7.0   SC92F_DDIC                                                        10/13/2026 10:46:31 PAGE 8   

              void DDIC_Control(uint8_t OutputPin,
                                DDIC_Control_Status DDIC_Contr)
              {
                uint16_t i;
                for(i=0;i<=7;i++)
                {
                  if((OutputPin>>i)&0x01)
                  {
                    if(DDIC_Contr)
                    {
                      LEDRAM[i] |= OutputPin;
                    }
                    else
                    {
                      LEDRAM[i] &= (~OutputPin);
                    }
                  }
                }
              }
              #else
 432          void DDIC_Control(DDIC_Control_SEG_TypeDef DDIC_Seg,
 433                            uint8_t DDIC_Com,
 434                            DDIC_Control_Status DDIC_Contr)
 435          {
 436   1        if(DDIC_Contr)
 437   1        {
 438   2          LCDRAM[DDIC_Seg] |= DDIC_Com;
 439   2        }
 440   1        else
 441   1        {
 442   2          LCDRAM[DDIC_Seg] &= (~DDIC_Com);
 443   2        }
 444   1      }
 445          #endif
 446          
 447          #endif
